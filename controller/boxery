#!/usr/bin/env bash
# shellcheck disable=SC2088 # tilde strings below intentionally refer to target home
# boxery: controller CLI. Runs on your laptop (macOS or Linux). Needs only ssh (+ a browser).
# Bash 3.2 compatible (stock macOS).
set -eu

# Registry: host-registry/NAME contains one absolute profile directory; default-host contains NAME.
# "legacy" is reserved for the root profile (and explicitly bypasses a named default).
ROOT_DIR="${BOXERY_HOME:-$HOME/.boxery}"
REGISTRY="$ROOT_DIR/host-registry"
TAB=$(printf '\t')
NL='
'

die() { echo "boxery: $*" >&2; exit 1; }
warn() { echo "boxery: $*" >&2; }
# ---------------------------------------------------------------- JSON output (no jq on the controller)
# Field names are stable; see docs/cli.md. Arrays are printed one element per line, like boxery-host.
json_text() { # STRING → "escaped"  (\ " tab newline escaped; other control characters dropped). For secrets use json_str.
	printf '"%s"' "$(printf '%s' "$1" | LC_ALL=C tr -d '\001-\010\013-\037' |
		sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e "s/$TAB/\\\\t/g" | awk 'NR > 1 { printf "\\n" } { printf "%s", $0 }')"
}
json_str_or_null() { if [ -n "$1" ]; then json_text "$1"; else printf null; fi; }
json_num_or_null() { case $1 in '' | *[!0-9-]*) printf null ;; *) printf '%s' "$1" ;; esac; }
json_array() { # element per line on stdin → JSON array
	awk 'NR == 1 { printf "[\n%s", $0; next } { printf ",\n%s", $0 } END { print (NR ? "\n]" : "[]") }'
}
has_flag() { f=$1; shift; for a in "$@"; do [ "$a" = "$f" ] && return 0; done; return 1; }

valid_alias() { valid_vm "${1:-}" && [ "$1" != legacy ]; }
need_alias() { valid_alias "${1:-}" || die "invalid host name: ${1:-} (legacy is reserved)"; }
# Only an absent path means "no selection"; symlinks (even dangling ones) are metadata.
metadata_present() { [ -e "$1" ] || [ -L "$1" ]; }
# Registry files are regular, readable data files, never shell snippets or symlinks.
one_line() {
	local line extra
	[ -f "$1" ] && [ -r "$1" ] && [ ! -L "$1" ] || die "invalid registry file: $1 (expected readable regular file, not symlink)"
	{ IFS= read -r line && ! IFS= read -r extra && [ -z "$extra" ]; } <"$1" || die "invalid registry file: $1"
	# Bash variables cannot retain NUL bytes. Compare the original bytes, not just the parsed line.
	cmp -s "$1" <(printf '%s\n' "$line") || die "invalid registry file: $1 (noncanonical bytes)"
	printf '%s\n' "$line"
}
default_host() {
	local name=legacy
	if metadata_present "$ROOT_DIR/default-host"; then name=$(one_line "$ROOT_DIR/default-host"); fi
	profile_dir "$name" >/dev/null
	printf '%s\n' "$name"
}
plain_path() { case $1 in *"$NL"*|*"$TAB"*|*$(printf '\r')*) die "paths cannot contain line breaks or tabs" ;; esac; }
profile_dir() {
	if [ "$1" = legacy ]; then printf '%s\n' "$ROOT_DIR"; return; fi
	need_alias "$1"
	metadata_present "$REGISTRY/$1" || die "unknown host: $1"
	dir=$(one_line "$REGISTRY/$1")
	case $dir in /*) ;; *) die "invalid profile directory for $1" ;; esac
	plain_path "$dir"
	[ -f "$dir/config" ] && [ -f "$dir/ssh_config" ] || die "incomplete profile: $1 ($dir)"
	printf '%s\n' "$dir"
}
select_profile() {
	selected=${1:-}
	if [ -z "$selected" ]; then selected=$(default_host); fi
	CONF_DIR=$(profile_dir "$selected")
	CONF_FILE="$CONF_DIR/config"; SSH_CONF="$CONF_DIR/ssh_config"; GRANTS_DIR="$CONF_DIR/grants"; LEASES_DIR="$CONF_DIR/leases"
	HOST=""; HOST_BIN='~/.local/bin/boxery-host'; IDENTITY=""
	# Configs are trusted, user-owned shell files. Never source registry pointers as shell code.
	# shellcheck source=/dev/null
	[ ! -f "$CONF_FILE" ] || . "$CONF_FILE"
	# Older Bash 3.2 printf %q left ~/ unquoted. Restore that literal prefix after source,
	# without rewriting imported config or evaluating its contents a second time.
	if [ -f "$CONF_FILE" ] && grep -q '^HOST_BIN=~/' "$CONF_FILE"; then
		case $HOST_BIN in "$HOME"/*) HOST_BIN="~/${HOST_BIN#"$HOME"/}" ;; esac
	fi
	if [ "$selected" = legacy ]; then
		HOST="${BOXERY_HOST:-$HOST}"; HOST_BIN="${BOXERY_HOST_BIN:-$HOST_BIN}"
	fi
}
# Literal shell serialization (unlike printf %q, never allows a leading ~ to expand on source).
literal() { local s=$1; s=${s//\'/\'\\\'\'}; printf "'%s'" "$s"; }
valid_dest() { case $1 in ''|-*|*[!A-Za-z0-9_.@:%+-]*) return 1 ;; esac; }
check_target() {
	valid_dest "$HOST" || die "invalid ssh destination: $HOST"
	case $HOST_BIN in ''|-*) die "invalid host executable path" ;; esac
	plain_path "$HOST_BIN"
}
# Expand only the supported ~/ prefix, on the machine where the executable lives.
remote_bin() { case $HOST_BIN in '~/'*) printf '"$HOME"/%s' "$(literal "${HOST_BIN#\~/}")" ;; *) literal "$HOST_BIN" ;; esac; }
# Double-quoted local-shell arguments also pass OpenSSH's ProxyCommand quote validator.
shell_double() { local s=$1; s=${s//\\/\\\\}; s=${s//\"/\\\"}; s=${s//\$/\\\$}; s=${s//\`/\\\`}; printf '"%s"' "$s"; }
ssh_value() { local s=$1; s=${s//\\/\\\\}; s=${s//\"/\\\"}; s=${s//%/%%}; printf '"%s"' "$s"; }
# Include applies glob expansion after SSH-config parsing; preserve literal path characters.
ssh_include_value() {
	local s=$1
	s=${s//\\/\\\\}; s=${s//\*/\\*}; s=${s//\?/\\?}; s=${s//\[/\\[}
	ssh_value "$s"
}

valid_snap() { case "${1:-}" in [A-Za-z0-9]*) ;; *) return 1 ;; esac; case "$1" in *[!A-Za-z0-9._-]*) return 1 ;; esac; [ ${#1} -le 64 ]; }
valid_vm() { case "${1:-}" in [a-z]*) ;; *) return 1 ;; esac; case "$1" in *[!a-z0-9-]*) return 1 ;; esac; [ ${#1} -le 31 ]; }
need_vm() { valid_vm "${1:-}" || die "invalid VM name: ${1:-}"; }
valid_image() { case "${1:-}" in *@*) valid_vm "${1%%@*}" && valid_snap "${1#*@}" ;; *) return 1 ;; esac; }
need_host() { [ -n "$HOST" ] || die "not configured; run: boxery setup user@host"; }
# HOST=local: the VM host is this machine (e.g. a Mac running Lima, or the Linux host itself).
is_local() { [ "$HOST" = local ]; }
# shellcheck disable=SC2088  # matching a literal "~/" prefix stored in config
local_host_bin() { case $HOST_BIN in "~/"*) printf '%s\n' "$HOME/${HOST_BIN#\~/}" ;; *) printf '%s\n' "$HOST_BIN" ;; esac; }
# Remote command line with every argument shell-quoted: ssh joins argv with spaces and the remote
# shell re-parses it, so unquoted args (snapshot names, flags) would be executed on the host.
quote_args() { out=""; for a in "$@"; do out="$out $(printf %q "$a")"; done; printf '%s' "$out"; }
h() {
	need_host
	if is_local; then "$(local_host_bin)" "$@"
	else check_target; ssh -o LogLevel=ERROR -- "$HOST" "exec $(remote_bin)$(quote_args "$@")"; fi
}
h_stdin() { h "$@"; }  # stdin is passed through by both branches
vm_ssh() { ssh -F "$SSH_CONF" "$@"; }
# Close the shared (ControlMaster) connection; required after revert/stop/rm or it points at a dead session.
drop_master() { [ -n "${1:-}" ] && ssh -F "$SSH_CONF" -O exit "$1.boxery" >/dev/null 2>&1 || true; }
open_url() {
	if command -v open >/dev/null 2>&1 && [ "$(uname)" = Darwin ]; then open "$1"
	elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$1" >/dev/null 2>&1 &
	else echo "open: $1"; fi
}
free_port() { # start
	p=$1
	while (echo >/dev/tcp/127.0.0.1/$p) >/dev/null 2>&1; do p=$((p + 1)); done
	echo "$p"
}

write_ssh_config() {
	mkdir -p "$CONF_DIR"
	key="${IDENTITY:-}"
	{
		echo "# generated by boxery setup — VMs are reached as <name>.boxery through the host"
		# Leased pool VMs: use that lease's own key (IdentitiesOnly so nothing else is offered).
		for lf in "$LEASES_DIR"/*.lease; do
			[ -f "$lf" ] || continue
			ln=$(sed -n 's/^name=//p' "$lf"); li=$(sed -n 's/^id=//p' "$lf")
			echo "Host $ln.boxery"
			echo "  IdentityFile $(ssh_value "$LEASES_DIR/$li.key")"
			echo "  IdentitiesOnly yes"
		done
		# Per-VM ssh-agent grants survive setup regenerating this file. Never forward to the host.
		for gf in "$GRANTS_DIR"/*; do
			[ -f "$gf" ] || continue
			has_grant "${gf##*/}" ssh-agent || continue
			echo "Host ${gf##*/}.boxery"
			echo "  ForwardAgent yes"
		done
		echo "Host *.boxery"
		echo "  ForwardAgent no"
		echo "  User agent"
		if is_local; then proxy="$(shell_double "$(local_host_bin)") connect"
		else proxy="ssh -o LogLevel=ERROR -- $(shell_double "$HOST") $(shell_double "exec $(remote_bin) connect")"; fi
		# ssh joins remote argv; the entire executable expression survives the local shell as one arg.
		# OpenSSH expands percent tokens before the local shell, so escape user-supplied percents.
		proxy=${proxy//%/%%}
		echo "  ProxyCommand $proxy %h %p"
		echo "  StrictHostKeyChecking no"
		echo "  UserKnownHostsFile /dev/null"
		echo "  LogLevel ERROR"
		echo "  ConnectTimeout 15"
		echo "  ServerAliveInterval 10"
		echo "  ServerAliveCountMax 3"
		echo "  ControlMaster auto"
		echo "  ControlPath $(ssh_value "$CONF_DIR/cm-")%h"
		echo "  ControlPersist 10m"
		if [ -n "$key" ]; then echo "  IdentityFile $(ssh_value "$key")"; fi
	} >"$SSH_CONF"
}

cmd_setup() {
	[ $# -ge 1 ] || die "usage: boxery setup user@host|local [--key ~/.ssh/id_ed25519.pub] [--host-bin PATH]"
	HOST=$1; shift
	pub=""
	while [ $# -gt 0 ]; do case $1 in --key|--host-bin) [ $# -ge 2 ] || die "$1 needs a value"; if [ "$1" = --key ]; then pub=$2; else HOST_BIN=$2; fi; shift 2 ;; *) die "unknown flag $1" ;; esac; done
	check_target
	if [ -z "$pub" ]; then for k in "$HOME/.ssh/id_ed25519.pub" "$HOME/.ssh/id_ecdsa.pub" "$HOME/.ssh/id_rsa.pub"; do [ -f "$k" ] && { pub=$k; break; }; done; fi
	[ -f "$pub" ] || die "no ssh public key found; pass --key"
	IDENTITY=${pub%.pub}
	plain_path "$IDENTITY"
	if is_local; then
		echo "==> local mode: the VM host is this machine"
		[ -x "$(local_host_bin)" ] || die "$(local_host_bin) not found; run host/boxery-host init here first"
		"$(local_host_bin)" help >/dev/null || die "cannot run $(local_host_bin)"
	else
		echo "==> checking ssh to $HOST"
		ssh -o LogLevel=ERROR -- "$HOST" "$(remote_bin) help >/dev/null" || die "cannot run $HOST_BIN on $HOST (is it installed? did you run boxery-host init?)"
	fi
	echo "==> registering $pub with host (applies to VMs created from now on)"
	h_stdin add-key <"$pub"
	mkdir -p "$CONF_DIR"
	{ printf 'HOST='; literal "$HOST"; printf '\nHOST_BIN='; literal "$HOST_BIN"; printf '\nIDENTITY='; literal "$IDENTITY"; printf '\n'; } >"$CONF_FILE.tmp.$$"
	mv "$CONF_FILE.tmp.$$" "$CONF_FILE"
	write_ssh_config
	if [ "$CONF_DIR" != "$ROOT_DIR" ] || [ "${selected:-legacy}" != legacy ]; then
		echo "==> named profile: use boxery --host NAME ssh VM (do not globally Include multiple profiles' *.boxery aliases)"
	elif [[ $SSH_CONF == *%* ]]; then
		# Older OpenSSH treats Include's % literally; newer clients expand percent tokens.
		# No single escaping is portable across both. -F already handles this path literally.
		echo "==> config path contains %; use boxery ssh VM or ssh -F $(literal "$SSH_CONF") VM.boxery instead of a global Include"
	else
		include="Include $(ssh_include_value "$SSH_CONF")"
		if [ -f "$HOME/.ssh/config" ] && { grep -qxF "$include" "$HOME/.ssh/config" || grep -qxF "Include $SSH_CONF" "$HOME/.ssh/config"; }; then :; else
			echo "==> add this line to the TOP of ~/.ssh/config so 'ssh NAME.boxery', VS Code, Zed etc. work:"
			printf '    %s\n' "$include"
		fi
	fi
	echo "==> done. Try: boxery new demo"
}

# Host mutations share a lock; registration/default files are published with atomic rename.
cmd_host() {
	action=${1:-ls}; [ $# -eq 0 ] || shift
	case $action in
	ls) [ $# -eq 0 ] || die "usage: boxery host ls"
		def=$(default_host)
		printf 'NAME\tDEFAULT\tCONFIG_DIR\n'
		printf 'legacy\t%s\t%s\n' "$([ "$def" != legacy ] || printf '*')" "$ROOT_DIR"
		for f in "$REGISTRY"/*; do alias=${f##*/}; valid_alias "$alias" || continue
			dir=$(profile_dir "$alias")
			printf '%s\t%s\t%s\n' "$alias" "$([ "$def" != "$alias" ] || printf '*')" "$dir"
		done; return ;;
	show) [ $# -eq 1 ] || die "usage: boxery host show NAME"; profile_dir "$1"; return ;;
	add|use|rm) ;;
	*) die "usage: boxery host add|ls|show|use|rm" ;;
	esac
	[ $# -ge 1 ] || die "host $action needs a name"
	alias=$1; shift
	if [ "$action" != use ] || [ "$alias" != legacy ]; then need_alias "$alias"; fi
	mkdir -p "$REGISTRY"
	mkdir "$REGISTRY/.lock" 2>/dev/null || die "host registry is locked; retry"
	cleanup_profile=""
	trap '[ -z "$cleanup_profile" ] || rm -rf "$cleanup_profile"; rmdir "$REGISTRY/.lock"' EXIT
	case $action in
	use) [ $# -eq 0 ] || die "usage: boxery host use NAME|legacy"
		profile_dir "$alias" >/dev/null
		# Do not overwrite/remove malformed metadata, or let mv move a file INTO a directory.
		def=$(default_host)
		if [ "$alias" = legacy ]; then rm -f "$ROOT_DIR/default-host"
		else printf '%s\n' "$alias" >"$ROOT_DIR/default-host.tmp.$$"; mv "$ROOT_DIR/default-host.tmp.$$" "$ROOT_DIR/default-host"; fi ;;
	rm) [ $# -eq 0 ] || die "usage: boxery host rm NAME"
		[ -f "$REGISTRY/$alias" ] || die "unknown host: $alias"
		def=$(default_host)
		[ "$def" != "$alias" ] || die "cannot forget selected default; first run host use OTHER or host use legacy"
		rm "$REGISTRY/$alias"
		echo "forgot $alias; profile data, VMs and grants were NOT deleted or revoked" ;;
	add) ! metadata_present "$REGISTRY/$alias" || die "host already registered: $alias"
		[ $# -ge 1 ] || die "usage: boxery host add NAME DEST [--key K] [--host-bin PATH] | --config-dir DIR"
		if [ "$1" = --config-dir ]; then
			[ $# -eq 2 ] || die "usage: boxery host add NAME --config-dir DIR"
			dir=$(cd "$2" && pwd -P) || die "no such config directory: $2"
			[ -f "$dir/config" ] && [ -f "$dir/ssh_config" ] || die "config and ssh_config required: $dir"
		else
			dir="$ROOT_DIR/profiles/$alias"
			! metadata_present "$dir" || die "profile data already exists: $dir (import it explicitly)"
			mkdir -p "$dir"; cleanup_profile=$dir
			CONF_DIR=$dir; CONF_FILE="$dir/config"; SSH_CONF="$dir/ssh_config"; GRANTS_DIR="$dir/grants"; LEASES_DIR="$dir/leases"
			HOST=""; HOST_BIN='~/.local/bin/boxery-host'; IDENTITY=""
			cmd_setup "$@"
		fi
		plain_path "$dir"
		printf '%s\n' "$dir" >"$REGISTRY/.tmp.$$"; mv "$REGISTRY/.tmp.$$" "$REGISTRY/$alias"
		cleanup_profile=""
		echo "registered $alias ($dir); select with: boxery host use $alias" ;;
	esac
}

cmd_attach() { # NAME [pi|opencode|shell] [session]
	name=$1; tool=${2:-pi}; sess=${3:-$tool}
	case $tool in
	pi) run='pi' ;;
	opencode) run='opencode' ;;
	shell) run='bash -l' ;;
	*) run=$tool ;;
	esac
	if has_pushed_grants "$name"; then grants_apply "$name" --quiet || true; fi
	# tmux keeps the agent alive when you disconnect (laptop sleep, network change).
	vm_ssh -t "$name.boxery" "cd ~/project 2>/dev/null; tmux has-session -t '$sess' 2>/dev/null || tmux new-session -d -s '$sess' -c ~/project \"bash -lc '$run; exec bash -l'\"; exec tmux attach -t '$sess'"
}

cmd_desktop() { # NAME [--no-open]
	name=$1; noopen=${2:-}
	port=$(free_port 16080)
	url="http://127.0.0.1:$port/vnc.html?autoconnect=1&resize=remote&reconnect=1"
	echo "==> desktop for $name at $url  (Ctrl-C to close the tunnel)"
	[ "$noopen" = "--no-open" ] || (sleep 1.5; open_url "$url") &
	exec ssh -F "$SSH_CONF" -N -o ControlMaster=no -o ControlPath=none -o ExitOnForwardFailure=yes -L "127.0.0.1:$port:127.0.0.1:6080" "$name.boxery"
}

cmd_forward() { # NAME PORT [LOCALPORT]
	name=$1; rport=$2; lport=${3:-$2}
	echo "==> localhost:$lport -> $name:$rport  (Ctrl-C to stop)"
	exec ssh -F "$SSH_CONF" -N -o ControlMaster=no -o ControlPath=none -o ExitOnForwardFailure=yes -L "127.0.0.1:$lport:127.0.0.1:$rport" "$name.boxery"
}

# ---------------------------------------------------------------- grants
# Per-VM, user-approved access to things on this machine. Stored locally (names/paths only, never
# values) in ~/.boxery/grants/NAME as "kind<TAB>key<TAB>extra" lines:
#   ssh-agent                     forward the local ssh agent (ForwardAgent for NAME.boxery only)
#   env   NAME   [command]        export NAME in the VM; value from the local env, or from `command`
#   file  /abs/local  remote      copy a local file into the VM (tmpfs), symlinked at `remote`
# env/file values are pushed over ssh into /run/user/<uid>/boxery (tmpfs, gone on reboot) whenever
# grants are applied: on grant/revoke, new, start, revert, attach, ssh, and by the pi extension.

grant_file() { echo "$GRANTS_DIR/$1"; }
has_grant() { [ -f "$(grant_file "$1")" ] && awk -F'\t' -v k="$2" '$1==k{f=1} END{exit !f}' "$(grant_file "$1")"; }
has_pushed_grants() { [ -f "$(grant_file "$1")" ] && awk -F'\t' '$1=="env"||$1=="file"||$1=="http"{f=1} END{exit !f}' "$(grant_file "$1")"; }
edge_marker() { echo "$GRANTS_DIR/.$1.edge"; }   # exists while the host holds edge routes for NAME

grants_lock() { # NAME cmd...: serialize local grant-store edits (mkdir is atomic everywhere)
	l="$GRANTS_DIR/.$1.lock"; mkdir -p "$GRANTS_DIR"; i=0
	while ! mkdir "$l" 2>/dev/null; do i=$((i + 1)); [ $i -lt 300 ] || die "grants for $1 are locked ($l)"; sleep 0.1; done
	shift; rc=0; "$@" || rc=$?; rmdir "$l"; return $rc
}

grant_put() { # NAME kind key extra
	mkdir -p "$GRANTS_DIR"; chmod 700 "$GRANTS_DIR"
	f=$(grant_file "$1"); touch "$f"; tmp="$f.tmp.$$"
	awk -F'\t' -v k="$2" -v a="$3" '!($1==k && $2==a)' "$f" >"$tmp"
	printf '%s\t%s\t%s\n' "$2" "$3" "$4" >>"$tmp"
	mv "$tmp" "$f"
}

grant_del() { # NAME kind key-or-remote → prints number removed
	f=$(grant_file "$1"); [ -f "$f" ] || { echo 0; return; }
	tmp="$f.tmp.$$"
	awk -F'\t' -v k="$2" -v a="$3" '($1==k && ($2==a || $3==a)){n++; next} {print} END{print n+0 > "/dev/stderr"}' "$f" 2>"$tmp.n" >"$tmp"
	mv "$tmp" "$f"; [ -s "$f" ] || rm -f "$f"
	cat "$tmp.n"; rm -f "$tmp.n"
}

abs_path() { # resolve a local path (file must exist)
	[ -e "$1" ] || die "no such local file: $1"
	d=$(cd "$(dirname "$1")" && pwd) || die "cannot resolve $1"
	echo "$d/$(basename "$1")"
}

valid_edge_host() { # DNS name with a dot; no IPs, ports, userinfo or paths (mirrors the proxy's check)
	case $1 in "" | *[!a-z0-9.-]* | .* | *. | *..* | -* | *-) return 1 ;; *.*) ;; *) return 1 ;; esac
	case ${1##*.} in *[!a-z]* | ?) return 1 ;; esac
	[ ${#1} -le 253 ]
}
valid_edge_auth() { # bearer | basic:USER | header:NAME
	case $1 in
	bearer) ;;
	basic:?*) case ${1#basic:} in *[!A-Za-z0-9._@+-]*) return 1 ;; esac ;;
	header:?*) case ${1#header:} in *[!A-Za-z0-9-]*) return 1 ;; esac
		case $(printf %s "${1#header:}" | tr 'A-Z' 'a-z') in host | content-length | connection | transfer-encoding | te | upgrade | proxy-connection | keep-alive | trailer) return 1 ;; esac ;;
	*) return 1 ;;
	esac
}

# grant_spec NAME SPEC [CMD] [dry] [AUTH] [RO]: validate (and unless dry, store) one grant.
#   ssh-agent | env:VAR | file:LOCAL[=REMOTE]   (REMOTE default: project/<basename>, relative to /home/agent)
#   http:HOST [--auth bearer|basic:USER|header:NAME] --cmd CMD [--readonly]   (edge-injected: value stays off the VM)
#   github [--readonly]   = http:github.com (basic:x-access-token) + http:api.github.com (bearer), from `gh auth token`
grant_spec() {
	n=$1; spec=$2; cmd=${3:-}; dry=${4:-}; auth=${5:-}; ro=${6:-}
	case $spec in http:* | github) ;; *) [ -z "$auth$ro" ] || die "--auth/--readonly only apply to http: grants" ;; esac
	case $spec in
	github)
		[ -z "$auth" ] || die "the github preset sets its own --auth"
		grant_spec "$n" http:github.com "${cmd:-gh auth token}" "$dry" basic:x-access-token "$ro"
		grant_spec "$n" http:api.github.com "${cmd:-gh auth token}" "$dry" bearer "$ro" ;;
	http:*)
		hst=${spec#http:}; auth=${auth:-bearer}
		valid_edge_host "$hst" || die "invalid host '$hst' (a DNS name like api.example.com; no scheme, port, path or IP)"
		valid_edge_auth "$auth" || die "invalid --auth '$auth' (bearer | basic:USER | header:NAME)"
		[ -n "$cmd" ] || die "http:$hst needs --cmd CMD (run on this machine at apply time to get the secret, e.g. --cmd 'gh auth token')"
		case $cmd in *"$TAB"* | *"$NL"*) die "--cmd must be a single line" ;; esac
		[ -n "$dry" ] || grants_lock "$n" grant_put "$n" http "$hst" "$auth;$ro;$cmd" ;;
	ssh-agent)
		[ -z "$cmd" ] || die "--cmd only applies to env grants"
		[ -n "$dry" ] || grants_lock "$n" grant_put "$n" ssh-agent "" "" ;;
	env:*)
		var=${spec#env:}
		case $var in [A-Za-z_]*) ;; *) die "invalid env var name: $var" ;; esac
		case $var in *[!A-Za-z0-9_]*) die "invalid env var name: $var" ;; esac
		case $cmd in *"$TAB"* | *"$NL"*) die "--cmd must be a single line" ;; esac
		[ -n "$dry" ] || grants_lock "$n" grant_put "$n" env "$var" "$cmd" ;;
	file:*)
		rest=${spec#file:}; loc=${rest%%=*}; rem=""
		case $rest in *=*) rem=${rest#*=} ;; esac
		[ -n "$loc" ] || die "usage: file:LOCAL[=REMOTE]"
		abs=$(abs_path "$loc"); [ -f "$abs" ] || die "not a regular file: $loc"
		[ "$(wc -c <"$abs")" -le 1048576 ] || die "file grants are limited to 1 MiB: $loc"
		[ -n "$rem" ] || rem="project/$(basename "$abs")"
		case "/$rem/" in */../* | *"$TAB"* | *"$NL"*) die "invalid remote path: $rem" ;; esac
		case "$abs" in *"$TAB"* | *"$NL"*) die "invalid local path: $abs" ;; esac
		[ -n "$dry" ] || grants_lock "$n" grant_put "$n" file "$abs" "$rem" ;;
	*) die "unknown grant '$spec' (use ssh-agent, env:VAR, file:LOCAL[=REMOTE], http:HOST or github)" ;;
	esac
}

grants_json() { # NAME → [{kind, …}]  (names/paths only, never values)
	f=$(grant_file "$1")
	{ [ -f "$f" ] && while IFS="$TAB" read -r kind a b; do
		case $kind in
		ssh-agent) echo '{"kind":"ssh-agent"}' ;;
		env) printf '{"kind":"env","var":%s,"cmd":%s}\n' "$(json_text "$a")" "$(json_str_or_null "$b")" ;;
		http) au=${b%%;*}; r=${b#*;}; ro=false; [ "${r%%;*}" = ro ] && ro=true
			printf '{"kind":"http","host":%s,"auth":%s,"readonly":%s,"cmd":%s}\n' "$(json_text "$a")" "$(json_text "$au")" "$ro" "$(json_str_or_null "${r#*;}")" ;;
		file) printf '{"kind":"file","local":%s,"remote":%s}\n' "$(json_text "$a")" "$(json_text "/home/agent/${b#/home/agent/}")" ;;
		esac
	done <"$f"; } | json_array
}
grants_inline() { grants_json "$1" | tr -d '\n'; }

grants_summary() { # NAME → "ssh-agent,env:X,file:project/.env"
	f=$(grant_file "$1"); [ -f "$f" ] || { echo "-"; return; }
	awk -F'\t' '{ s = ($1=="ssh-agent") ? "ssh-agent" : ($1=="env") ? "env:" $2 : ($1=="http") ? "http:" $2 : "file:" $3; out = out (out ? "," : "") s } END{print out ? out : "-"}' "$f"
}

env_value() { # VAR CMD → value on stdout
	if [ -n "${2:-}" ]; then
		v=$(sh -c "$2") || { warn "grant env:$1: command failed: $2"; return 1; }
	else
		v=$(printenv "$1" 2>/dev/null || true)
	fi
	[ -n "$v" ] || { warn "grant env:$1: no value on this machine (set it, or: boxery grant VM env:$1 --cmd '...'); skipped"; return 1; }
	printf '%s' "$v"
}

json_str() { # value → JSON string (refuses control characters rather than escaping them)
	case $1 in *[[:cntrl:]]*) return 1 ;; esac
	printf '"%s"' "$(printf %s "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')"
}
b64() { printf %s "$1" | base64 | tr -d '\n'; }

# Edge routes JSON for the host proxy: {"HOST": {"headers": {...}, "readonly": bool}, ...}.
# Each distinct --cmd runs once per apply (the github preset shares one `gh auth token`).
edge_routes_json() {
	f=$(grant_file "$1"); out=""; cache_k=""; cache_v=""
	[ -f "$f" ] || { echo '{}'; return; }
	while IFS="$TAB" read -r kind hst extra; do
		[ "$kind" = http ] || continue
		auth=${extra%%;*}; r=${extra#*;}; ro=${r%%;*}; cmd=${r#*;}
		if [ "$cmd" = "$cache_k" ]; then v=$cache_v
		else
			v=$(sh -c "$cmd" </dev/null) || { warn "grant http:$hst: command failed: $cmd; skipped"; continue; }
			v=$(printf %s "$v" | tr -d '\r\n'); cache_k=$cmd; cache_v=$v
		fi
		[ -n "$v" ] || { warn "grant http:$hst: '$cmd' printed nothing; skipped"; continue; }
		case $auth in
		bearer) hn=Authorization; hv="Bearer $v" ;;
		basic:*) hn=Authorization; hv="Basic $(b64 "${auth#basic:}:$v")" ;;
		header:*) hn=${auth#header:}; hv=$v ;;
		esac
		jv=$(json_str "$hv") || { warn "grant http:$hst: value has control characters; skipped"; continue; }
		out="$out${out:+,}\"$hst\":{\"headers\":{\"$hn\":$jv},\"readonly\":$([ "$ro" = ro ] && echo true || echo false)}"
	done <"$f"
	echo "{$out}"
}

edge_apply() { # NAME: push (or clear) the VM's edge routes on the host
	m=$(edge_marker "$1")
	if [ -f "$(grant_file "$1")" ] && grep -q "^http$TAB" "$(grant_file "$1")"; then
		edge_routes_json "$1" | h edge-set "$1" >/dev/null || { warn "could not set edge routes for $1 on the host"; return 1; }
		: >"$m"
	elif [ -f "$m" ]; then
		echo '{}' | h edge-set "$1" >/dev/null && rm -f "$m"
	fi
}

# Script run in the VM (stdin of `bash -s`): reconciles the tmpfs state to exactly the current grants.
build_apply_script() {
	f=$(grant_file "$1")
	cat <<'EOF'
set -eu
umask 077
RT=${BOXERY_RUNTIME_DIR:-/run/user/$(id -u)}
for _ in $(seq 30); do [ -d "$RT" ] && break; sleep 1; done   # appears once the user manager is up (lingering)
[ -d "$RT" ] || { echo "boxery: $RT missing (no user runtime dir)" >&2; exit 1; }
R=$RT/boxery
mkdir -p "$R/files"
# One apply at a time per VM (concurrent attach/revoke must not interleave staging files).
exec 9>"$R/.lock"; if command -v flock >/dev/null; then flock 9; fi
: >"$R/env.sh.new"; : >"$R/links.new"; : >"$R/targets.new"; : >"$R/gitconfig.new"
# Edge grants: the VM only learns *where* to send requests; the host proxy adds the credential.
TOK=$(cat "$HOME/.boxery/token" 2>/dev/null || cat "$HOME/.agentvm/token" 2>/dev/null || true)
EDGE="http://127.0.0.1:8088/edge/$(printf %s "$TOK" | sed 's/:/%3A/')"
put_edge() {
	[ -n "$TOK" ] || { echo "boxery: no proxy token in the VM; http grants unavailable" >&2; return 0; }
	grep -q '^export BOXERY_EDGE=' "$R/env.sh.new" || printf 'export BOXERY_EDGE=%q\n' "$EDGE" >>"$R/env.sh.new"
	printf '[url "%s/%s/"]\n\tinsteadOf = https://%s/\n' "$EDGE" "$1" "$1" >>"$R/gitconfig.new"
	[ "$1" != registry.npmjs.org ] || printf 'export npm_config_registry=%q\n' "$EDGE/registry.npmjs.org/" >>"$R/env.sh.new"
}
put_env() { v=$(printf %s "$2" | base64 -d); printf 'export %s=%q\n' "$1" "$v" >>"$R/env.sh.new"; }
put_file() {
	d=$1; case "$d" in /*) ;; *) d=$HOME/$d ;; esac
	case "/$d/" in */../*) echo "boxery: refusing path with ..: $d" >&2; return 0 ;; esac
	case "$d" in "$HOME"/*) ;; *) echo "boxery: refusing file grant outside $HOME: $d" >&2; return 0 ;; esac
	t=$R/files/$(printf %s "$d" | cksum | cut -d' ' -f1)
	rm -f "$t"; printf %s "$2" | base64 -d >"$t"; chmod 0400 "$t"
	echo "$t" >>"$R/targets.new"
	if [ -e "$d" ] && [ ! -L "$d" ]; then echo "boxery: $d exists as a real file; not replacing it" >&2; return 0; fi
	mkdir -p "$(dirname "$d")"; ln -sfn "$t" "$d"; echo "$d" >>"$R/links.new"
	case "$d" in "$HOME"/project/*)
		if [ -d "$HOME/project/.git" ]; then
			ex=$HOME/project/.git/info/exclude; rel=/${d#"$HOME"/project/}
			mkdir -p "$(dirname "$ex")"; touch "$ex"; grep -qxF "$rel" "$ex" || echo "$rel" >>"$ex"
		fi ;;
	esac
}
EOF
	if [ -f "$f" ]; then
		while IFS="$TAB" read -r kind a b; do
			case $kind in
			env) v=$(env_value "$a" "$b") || continue
				printf 'put_env %s %s\n' "$a" "$(printf %s "$v" | base64 | tr -d '\n')" ;;
			http) printf 'put_edge %s\n' "$a" ;;
			file) [ -r "$a" ] || { warn "grant file:$a: not readable; skipped"; continue; }
				printf 'put_file %s %s\n' "$(printf %q "$b")" "$(base64 <"$a" | tr -d '\n')" ;;
			esac
		done <"$f"
	fi
	cat <<'EOF'
mv "$R/env.sh.new" "$R/env.sh"
mv "$R/gitconfig.new" "$R/gitconfig"
# git ignores a missing include, so this one-time line is harmless after revoke or reboot.
if [ -s "$R/gitconfig" ] && ! git config --global --get-all include.path 2>/dev/null | grep -qxF "$R/gitconfig"; then
	git config --global --add include.path "$R/gitconfig"
fi
if [ -f "$R/links" ]; then
	while IFS= read -r old; do
		grep -qxF "$old" "$R/links.new" && continue
		if [ -L "$old" ]; then case "$(readlink "$old")" in "$R"/*) rm -f "$old" ;; esac; fi
	done <"$R/links"
fi
mv "$R/links.new" "$R/links"
for t in "$R"/files/*; do [ -e "$t" ] || continue; grep -qxF "$t" "$R/targets.new" || rm -f "$t"; done
rm -f "$R/targets.new"
hook='[ -r "/run/user/$(id -u)/boxery/env.sh" ] && . "/run/user/$(id -u)/boxery/env.sh"  # boxery-grants'
for rc in "$HOME/.profile" "$HOME/.bashrc"; do
	touch "$rc"
	grep -q 'boxery-grants' "$rc" || { printf '%s\n' "$hook" | cat - "$rc" >"$rc.boxery" && cat "$rc.boxery" >"$rc" && rm -f "$rc.boxery"; }
done
echo "boxery: grants applied ($(grep -c . "$R/env.sh" || true) env, $(grep -c . "$R/links" || true) files, $(grep -c insteadOf "$R/gitconfig" || true) http)"
EOF
}

grants_apply() { # NAME [--quiet]
	edge_apply "$1" || true
	out=$(build_apply_script "$1" | vm_ssh "$1.boxery" 'bash -s' 2>&1) || { warn "could not apply grants to $1: $out"; return 1; }
	[ "${2:-}" = --quiet ] || echo "==> $out"
}

# After a grant change: regenerate ForwardAgent config, stop the shared connection from taking new
# sessions (running ones finish; the next connection uses the new config), push env/file state.
# After a grant change: regenerate ForwardAgent config and close the shared connection so the next
# one uses it. `-O exit` (not `stop`) also tears down existing sessions, so a revoked ssh-agent
# forward can't keep signing through an already-open channel.
grants_changed() {
	write_ssh_config
	if ssh -F "$SSH_CONF" -O check "$1.boxery" >/dev/null 2>&1; then
		ssh -F "$SSH_CONF" -O exit "$1.boxery" >/dev/null 2>&1 || true
		echo "==> closed open connections to $1 so the change takes effect (attached sessions will reconnect)"
	fi
	grants_apply "$1" || warn "grants for $1 are saved; they'll be applied on the next start/attach"
}

cmd_grant() { # NAME SPEC... [--cmd CMD]
	need_host; need_vm "${1:-}"; n=$1; shift
	[ $# -gt 0 ] || die "usage: boxery grant NAME ssh-agent | env:VAR [--cmd CMD] | file:LOCAL[=REMOTE] | http:HOST --cmd CMD [--auth A] [--readonly] | github ..."
	while [ $# -gt 0 ]; do
		spec=$1; shift; cmd=""; auth=""; ro=""
		while [ $# -gt 0 ]; do
			case $1 in
			--cmd) [ $# -ge 2 ] || die "--cmd needs a value"; cmd=$2; shift 2 ;;
			--auth) [ $# -ge 2 ] || die "--auth needs a value"; auth=$2; shift 2 ;;
			--readonly) ro=ro; shift ;;
			*) break ;;
			esac
		done
		grant_spec "$n" "$spec" "$cmd" "" "$auth" "$ro"
		echo "==> granted $spec to $n"
	done
	case $(grants_summary "$n") in *ssh-agent*) echo "==> note: processes in $n can use your ssh keys while you're connected. Trusted VMs only." ;; esac
	grants_changed "$n"
}

cmd_revoke() { # NAME SPEC...|all
	need_host; need_vm "${1:-}"; n=$1; shift
	[ $# -gt 0 ] || die "usage: boxery revoke NAME ssh-agent | env:VAR | file:LOCAL-or-REMOTE | all"
	for spec in "$@"; do
		case $spec in
		all) rm -f "$(grant_file "$n")"; echo "==> revoked all grants for $n" ;;
		ssh-agent) [ "$(grants_lock "$n" grant_del "$n" ssh-agent "")" -gt 0 ] && echo "==> revoked ssh-agent" || warn "no ssh-agent grant" ;;
		http:*) [ "$(grants_lock "$n" grant_del "$n" http "${spec#http:}")" -gt 0 ] && echo "==> revoked $spec" || warn "no grant $spec" ;;
		github) c=0; for gh_h in github.com api.github.com; do c=$((c + $(grants_lock "$n" grant_del "$n" http "$gh_h"))); done
			[ $c -gt 0 ] && echo "==> revoked github" || warn "no github grant" ;;
		env:*) [ "$(grants_lock "$n" grant_del "$n" env "${spec#env:}")" -gt 0 ] && echo "==> revoked $spec" || warn "no grant $spec" ;;
		file:*) k=${spec#file:}; [ -e "$k" ] && k=$(abs_path "$k")
			[ "$(grants_lock "$n" grant_del "$n" file "$k")" -gt 0 ] && echo "==> revoked $spec" || warn "no grant $spec" ;;
		*) die "unknown grant '$spec'" ;;
		esac
	done
	grants_changed "$n"
}

cmd_grants() { # NAME [apply [--quiet] | --json]
	need_vm "${1:-}"; n=$1
	if [ "${2:-}" = apply ]; then need_host; grants_apply "$n" "${3:-}"; return; fi
	if [ "${2:-}" = --json ]; then grants_json "$n"; return; fi
	[ -z "${2:-}" ] || die "usage: boxery grants NAME [apply [--quiet] | --json]"
	f=$(grant_file "$n")
	[ -f "$f" ] || { echo "no grants for $n"; return; }
	echo "grants for $n (values are read from this machine when applied; never stored):"
	while IFS="$TAB" read -r kind a b; do
		case $kind in
		ssh-agent) echo "  ssh-agent   forward your local ssh agent" ;;
		env) echo "  env:$a${b:+   (from: $b)}" ;;
		file) echo "  file:$a → /home/agent/${b#/home/agent/}" ;;
		http) au=${b%%;*}; r=${b#*;}; echo "  http:$a   ($au, from: ${r#*;})$([ "${r%%;*}" = ro ] && echo "  read-only")   value injected by the host proxy; never in the VM" ;;
		esac
	done <"$f"
}

cmd_agent_forward() { # NAME on|off  (alias for grant/revoke ssh-agent)
	[ $# -eq 2 ] || die "usage: boxery agent-forward NAME on|off"
	case $2 in
	on) cmd_grant "$1" ssh-agent ;;
	off) need_host; need_vm "$1"; grant_del "$1" ssh-agent "" >/dev/null; echo "==> agent forwarding off for $1"; grants_changed "$1" ;;
	*) die "usage: boxery agent-forward NAME on|off" ;;
	esac
}

migrate_legacy_agent_forward() { # ~/.boxery/agent-forward/NAME markers → grants
	[ -d "$CONF_DIR/agent-forward" ] || return 0
	for m in "$CONF_DIR"/agent-forward/*; do
		[ -f "$m" ] || continue
		valid_vm "${m##*/}" && grant_put "${m##*/}" ssh-agent "" ""
	done
	rm -rf "$CONF_DIR/agent-forward"
	[ -n "$HOST" ] && write_ssh_config || true
}

cmd_new() { # NAME [--cpus N --mem MiB --disk GiB] [--from IMAGE] [--grant SPEC]... [--agent-forward]
	name=""; pass=""; specs=""; from=""
	while [ $# -gt 0 ]; do
		case $1 in
		--from) valid_image "${2:-}" || die "invalid image name: ${2:-} (use VM@SNAP)"; from=$2; shift 2 ;;
		--grant) [ $# -ge 2 ] || die "--grant needs a value"; specs="$specs$2$NL"; shift 2 ;;
		--agent-forward) specs="${specs}ssh-agent$NL"; shift ;;
		--cpus | --mem | --disk) [ $# -ge 2 ] || die "$1 needs a value"
			case $2 in '' | *[!0-9]*) die "$1 must be a number" ;; esac
			pass="$pass $1 $2"; shift 2 ;;
		-*) die "unknown flag $1" ;;
		*) name=$1; shift ;;
		esac
	done
	need_vm "$name"
	# validate grants before creating anything
	while IFS= read -r sp; do [ -n "$sp" ] && grant_spec "$name" "$sp" "" dry; done <<EOF
$specs
EOF
	h new "$name" $pass ${from:+--from "$from"}
	if [ -n "$specs" ]; then
		while IFS= read -r sp; do [ -n "$sp" ] && grant_spec "$name" "$sp" ""; done <<EOF
$specs
EOF
		echo "==> grants for $name: $(grants_summary "$name")"
		grants_changed "$name"
	fi
}

# fork SRC DST... [--cpus N --mem MiB --disk GiB] [--grants]: copy SRC (running or not) into new VMs.
# Each fork is a pet with its own identity. Grants are per VM and not copied unless --grants is given
# (then the fork gets the same grant list, applied from this machine).
cmd_fork() {
	src=""; dsts=""; pass=""; copy_grants=""
	while [ $# -gt 0 ]; do
		case $1 in
		--cpus | --mem | --disk) [ $# -ge 2 ] || die "$1 needs a value"
			case $2 in '' | *[!0-9]*) die "$1 must be a number" ;; esac
			pass="$pass $1 $2"; shift 2 ;;
		--grants) copy_grants=1; shift ;;
		-*) die "unknown flag $1" ;;
		*) need_vm "$1"; if [ -z "$src" ]; then src=$1; else dsts="$dsts $1"; fi; shift ;;
		esac
	done
	[ -n "$src" ] && [ -n "$dsts" ] || die "usage: boxery fork SRC DST... [--cpus N --mem MiB --disk GiB] [--grants]"
	# shellcheck disable=SC2086  # word splitting of validated names/flags is intended
	h fork "$src" $dsts $pass || rc=$?
	for d in $dsts; do
		if [ -n "$copy_grants" ] && [ -f "$(grant_file "$src")" ]; then
			mkdir -p "$GRANTS_DIR"; cp "$(grant_file "$src")" "$(grant_file "$d")"
			echo "==> grants for $d: $(grants_summary "$d")" >&2
			grants_changed "$d" >/dev/null 2>&1 || warn "could not apply grants to $d"
		fi
	done
	return "${rc:-0}"
}

# ---------------------------------------------------------------- leases
# A lease = exclusive use of a pool VM until it expires or is released. Each lease gets its own
# throwaway ssh key; the host installs it in the VM, and removes it (by resetting the VM) on release
# or expiry, so a stale holder is locked out. Local record: ~/.boxery/leases/<id>.{lease,key,key.pub}.

lease_file() { echo "$LEASES_DIR/$1.lease"; }
lease_by_name() { grep -l "^name=$1\$" "$LEASES_DIR"/*.lease 2>/dev/null | head -1; }

cmd_acquire() { # [--ttl S] [--wait S] [--holder H] → prints "NAME LEASE_ID" (stdout) for scripts
	need_host
	ttl=1800; wait=0; holder="${USER:-user}@$(hostname -s 2>/dev/null || hostname)"
	while [ $# -gt 0 ]; do
		case $1 in
		--ttl | --wait) case ${2:-} in '' | *[!0-9]*) die "$1 must be a number" ;; esac
			[ "$1" = --ttl ] && ttl=$2 || wait=$2; shift 2 ;;
		--holder) holder=${2:-}; shift 2 ;;
		*) die "unknown flag $1" ;;
		esac
	done
	mkdir -p "$LEASES_DIR"; chmod 700 "$LEASES_DIR"
	tmpk="$LEASES_DIR/.new-$$"
	ssh-keygen -q -t ed25519 -N "" -C "boxery-lease $holder" -f "$tmpk" || die "ssh-keygen failed"
	out=$(h_stdin acquire --holder "$holder" --ttl "$ttl" --wait "$wait" <"$tmpk.pub") || { rc=$?; rm -f "$tmpk" "$tmpk.pub"; exit $rc; }
	set -- $out; name=$1; id=$2; exp=$3
	valid_vm "$name" || { rm -f "$tmpk" "$tmpk.pub"; die "bad response from host: $out"; }
	case $id in l-*) ;; *) rm -f "$tmpk" "$tmpk.pub"; die "bad response from host: $out" ;; esac
	mv "$tmpk" "$LEASES_DIR/$id.key"; mv "$tmpk.pub" "$LEASES_DIR/$id.key.pub"
	printf 'name=%s\nid=%s\nexpires=%s\nttl=%s\nholder=%s\n' "$name" "$id" "$exp" "$ttl" "$holder" >"$(lease_file "$id")"
	drop_master "$name"; write_ssh_config
	if has_pushed_grants "$name"; then grants_apply "$name" --quiet || true; fi
	echo "==> leased $name (lease $id, expires in $((exp - $(date +%s)))s; renew with: boxery renew $name)" >&2
	echo "$name $id"
}

resolve_lease() { # NAME-or-LEASE_ID → lease file
	case $1 in l-*) f=$(lease_file "$1") ;; *) f=$(lease_by_name "$1") ;; esac
	[ -n "$f" ] && [ -f "$f" ] || die "no local lease for '$1' (boxery leases)"
	echo "$f"
}

cmd_renew() { # NAME|LEASE [--ttl S]
	need_host; f=$(resolve_lease "${1:-}"); id=$(sed -n 's/^id=//p' "$f")
	ttl=$(sed -n 's/^ttl=//p' "$f"); [ "${2:-}" = --ttl ] && ttl=${3:-$ttl}
	case $ttl in '' | *[!0-9]*) die "--ttl must be a number" ;; esac
	out=$(h renew "$id" --ttl "$ttl") || die "renew failed (lease expired or released?)"
	set -- $out
	sed -i.bak "s/^expires=.*/expires=$2/" "$f" && rm -f "$f.bak"
	echo "==> renewed $1 until $(date -d "@$2" 2>/dev/null || date -r "$2")"
}

cmd_release() { # NAME|LEASE
	need_host; f=$(resolve_lease "${1:-}"); id=$(sed -n 's/^id=//p' "$f"); name=$(sed -n 's/^name=//p' "$f")
	drop_master "$name"
	h release "$id" || warn "host did not release $id (already expired?); forgetting it locally"
	rm -f "$f" "$LEASES_DIR/$id.key" "$LEASES_DIR/$id.key.pub"
	rm -f "$(grant_file "$name")" "$(edge_marker "$name")"   # grants were for this lease; the host reset clears edge routes
	write_ssh_config
	echo "==> released $name"
}

cmd_leases() { # [--json]   local leases
	json=0; case ${1:-} in --json) json=1 ;; '') ;; *) die "usage: boxery leases [--json]" ;; esac
	now=$(date +%s); found=0
	for f in "$LEASES_DIR"/*.lease; do
		[ -f "$f" ] || continue; found=1
		n=$(sed -n 's/^name=//p' "$f"); e=$(sed -n 's/^expires=//p' "$f"); i=$(sed -n 's/^id=//p' "$f")
		case $e in '' | *[!0-9]*) e=0 ;; esac
		if [ $json = 1 ]; then
			left=$((e - now)); [ $left -gt 0 ] || left=0
			printf '{"name":%s,"lease_id":%s,"expires_at":%s,"expires_in":%s,"ttl":%s,"holder":%s}\n' "$(json_text "$n")" "$(json_text "$i")" "$e" "$left" \
				"$(json_num_or_null "$(sed -n 's/^ttl=//p' "$f")")" "$(json_str_or_null "$(sed -n 's/^holder=//p' "$f")")"
			continue
		fi
		if [ "$e" -gt "$now" ]; then left="$((e - now))s"; else left=expired; fi
		printf '%-16s %-10s %s\n' "$n" "$left" "$i"
	done | if [ $json = 1 ]; then json_array; else cat; fi
	[ $json = 1 ] || [ $found = 1 ] || echo "(no leases)"
}

cmd_ls() { # [--json]
	if [ "${1:-}" = --json ]; then ls_json; return; fi
	[ -z "${1:-}" ] || die "usage: boxery ls [--json]"
	out=$(h ls) || exit $?
	printf '%s\n' "$out" | while IFS= read -r line; do
		n=${line%% *}
		if [ "$n" = NAME ]; then printf '%-62s %s\n' "$line" GRANTS
		else printf '%-62s %s\n' "$line" "$(grants_summary "$n")"; fi
	done
}

# The host prints one array element per line; add this machine's grants to each VM.
ls_json() {
	out=$(h ls --json) || exit $?
	case $out in '['*) ;; *) die "host returned no JSON for 'ls --json' (update boxery-host on $HOST)" ;; esac
	printf '%s\n' "$out" | while IFS= read -r line; do
		case $line in
		'{"name":"'*)
			n=${line#\{\"name\":\"}; n=${n%%\"*}
			valid_vm "$n" || die "bad VM name from host: $n"
			sep=; case $line in *,) sep=,; line=${line%,} ;; esac
			printf '%s,"grants":%s}%s\n' "${line%\}}" "$(grants_inline "$n")" "$sep" ;;
		*) printf '%s\n' "$line" ;;
		esac
	done
}

cmd_sessions() { # NAME [--json]
	need_vm "${1:-}"
	case ${2:-} in
	'') vm_ssh "$1.boxery" 'tmux ls 2>/dev/null || echo "(no tmux sessions)"' ;;
	--json)
		out=$(vm_ssh "$1.boxery" "tmux ls -F '#{session_name}${TAB}#{session_windows}${TAB}#{session_created}${TAB}#{session_attached}' 2>/dev/null; true") || die "cannot reach $1"
		printf '%s\n' "$out" | while IFS="$TAB" read -r sn w c at; do
			[ -n "$sn" ] || continue
			case $at in '' | 0) at=false ;; *) at=true ;; esac
			printf '{"name":%s,"windows":%s,"created":%s,"attached":%s}\n' "$(json_text "$sn")" "$(json_num_or_null "$w")" "$(json_num_or_null "$c")" "$at"
		done | json_array ;;
	*) die "usage: boxery sessions NAME [--json]" ;;
	esac
}

cmd_prompt() { # NAME "prompt" — fire-and-forget pi task in a detached tmux window, logged to ~/project/.boxery/
	name=$1; shift; prompt="$*"
	[ -n "$prompt" ] || die "usage: boxery prompt NAME \"task...\""
	id=task-$(date +%Y%m%d-%H%M%S)
	b64=$(printf '%s' "$prompt" | base64 | tr -d '\n')
	# Ship the prompt base64-encoded and write a tiny runner script: no nested shell quoting.
	vm_ssh "$name.boxery" "set -e; d=~/project/.boxery; mkdir -p \$d; echo $b64 | base64 -d > \$d/$id.prompt
		printf '%s\n' '#!/bin/bash -l' 'cd ~/project' 'pi -p \"\$(cat .boxery/$id.prompt)\" </dev/null 2>&1 | tee .boxery/$id.log' 'echo \"[boxery] task finished (exit \${PIPESTATUS[0]})\" | tee -a .boxery/$id.log' 'exec bash -l' > \$d/$id.sh
		chmod +x \$d/$id.sh; tmux new-session -d -s $id -c ~/project \$d/$id.sh"
	echo "started $id on $name — watch: boxery attach $name pi $id   log: boxery run $name cat project/.boxery/$id.log"
}

usage() {
	cat <<-'EOF'
		boxery — remote desktop VMs for coding agents

		--host NAME COMMAND             route a command to a registered host (or legacy)
		host add NAME DEST [--key K.pub] [--host-bin PATH]
		host add NAME --config-dir DIR   import existing config/ssh_config without setup
		host ls | show NAME | use NAME|legacy | rm NAME
		setup user@host|local [--key K.pub] [--host-bin PATH]
		                                configure the VM host (local = this machine) + register your ssh key
		new NAME [--cpus N --mem MiB --disk GiB] [--grant SPEC]... [--agent-forward]
		ls [--json]                     list VMs (with their grants)
		rm NAME                         destroy VM (revokes its LLM token)
		start|stop NAME
		fork SRC DST... [--grants]      copy a VM (running or not) into new VMs, ~10 s; each gets its own
		                                identity (--grants: give the forks SRC's grants too)
		snap NAME [SNAP] | snaps NAME [--json] | revert NAME SNAP | snap-rm NAME SNAP
		new NAME --from NAME@SNAP       new VM from a snapshot (also: boxery images)

		ssh NAME [cmd...]               shell into VM (also: ssh NAME.boxery)
		run NAME cmd...                 run a command
		attach NAME [pi|opencode|shell] [session]
		                                attach to a persistent tmux session running the agent
		prompt NAME "task"              start a headless pi task in the background
		sessions NAME [--json]          list tmux sessions
		desktop NAME [--no-open]        open the XFCE desktop in your browser (noVNC over ssh)
		forward NAME PORT [LOCAL]       forward a VM port to localhost
		acquire [--ttl S] [--wait S]    lease a VM from the shared pool (prints NAME LEASE_ID)
		renew NAME [--ttl S]            extend your lease;  release NAME   give it back (VM is reset)
		leases [--json]                 your leases;  pool add|rm|ls (admin, on the host)
		grant NAME SPEC... [--cmd CMD]  give a VM access to something on this machine:
		                                  ssh-agent | env:VAR | file:LOCAL[=REMOTE]
		                                  http:HOST --cmd CMD [--auth bearer|basic:USER|header:NAME] [--readonly]
		                                  github [--readonly]   (http: grants never put the secret in the VM)
		revoke NAME SPEC...|all         take it away (pushed values are deleted from the VM)
		grants NAME [apply | --json]    show grants / push them again
		agent-forward NAME on|off       same as grant/revoke NAME ssh-agent
		proxy-log [N]                   recent LLM + edge (http: grant) requests on the host

		--json on ls, snaps, sessions, leases, grants prints JSON (fields: docs/cli.md)
	EOF
}

# Canonical root pointers work even when BOXERY_HOME was relative.
plain_path "$ROOT_DIR"
case $ROOT_DIR in /*) ;; *) ROOT_DIR="$PWD/$ROOT_DIR"; REGISTRY="$ROOT_DIR/host-registry" ;; esac
explicit=""
if [ "${1:-}" = --host ]; then
	[ $# -ge 3 ] || die "usage: boxery --host NAME COMMAND"
	explicit=$2; [ -n "$explicit" ] || die "invalid host name"; shift 2
fi
cmd=${1:-help}; [ $# -gt 0 ] && shift
if [ "$cmd" = host ]; then [ -z "$explicit" ] || die "--host does not apply to host management"; cmd_host "$@"; exit; fi
select_profile "$explicit"
migrate_legacy_agent_forward
case $cmd in
setup) cmd_setup "$@" ;;
rm) need_host; drop_master "${1:-}"; h rm "$@"; drop_master "${1:-}"; rm -f "$(grant_file "${1:-x}")" "$(edge_marker "${1:-x}")"; write_ssh_config ;;
stop) need_host; drop_master "${1:-}"; h stop "$@"; drop_master "${1:-}" ;;
start) need_host; drop_master "${1:-}"; h start "$@"; drop_master "${1:-}"; if has_pushed_grants "${1:-x}"; then grants_apply "$1" || true; fi ;;
# a revert restores the snapshot's tmpfs too: always reconcile to the current grants
revert) need_host; valid_snap "${2:-}" || die "invalid snapshot name: ${2:-}"; drop_master "${1:-}"; h revert "$@"; drop_master "${1:-}"; grants_apply "$1" --quiet || true ;;
snap) need_host
	[ -z "${2:-}" ] || valid_snap "$2" || die "invalid snapshot name: $2"
	h snap "$@" ;;
new) need_host; cmd_new "$@" ;;
fork) need_host; cmd_fork "$@" ;;
snap-rm) need_host; [ -n "${2:-}" ] && valid_snap "$2" || die "usage: boxery snap-rm NAME SNAP"; h snap-rm "$@" ;;
images) need_host; h images ;;
ls | list) need_host; cmd_ls "$@" ;;
snaps) need_host; need_vm "${1:-}"; h snaps "$@" ;;
proxy-log) need_host; h "$cmd" "$@" ;;
ssh) need_host; n=$1; shift; if has_pushed_grants "$n"; then grants_apply "$n" --quiet || true; fi; vm_ssh -t "$n.boxery" "$@" ;;
run) need_host; n=$1; shift; vm_ssh "$n.boxery" "$@" ;;
attach) need_host; cmd_attach "$@" ;;
desktop) need_host; cmd_desktop "$@" ;;
forward) need_host; cmd_forward "$@" ;;
acquire) cmd_acquire "$@" ;;
renew) cmd_renew "$@" ;;
release) cmd_release "$@" ;;
leases) cmd_leases "$@" ;;
pool) need_host; [ -z "${2:-}" ] || drop_master "$2"; h pool "$@"; [ -z "${2:-}" ] || drop_master "$2" ;;
grant) cmd_grant "$@" ;;
revoke) cmd_revoke "$@" ;;
grants) cmd_grants "$@" ;;
agent-forward) cmd_agent_forward "$@" ;;
sessions) need_host; cmd_sessions "$@" ;;
prompt) need_host; cmd_prompt "$@" ;;
help | -h | --help) usage ;;
*) usage; exit 1 ;;
esac
