#!/usr/bin/env bash
# agentvm: controller CLI. Runs on your laptop (macOS or Linux). Needs only ssh (+ a browser).
# Bash 3.2 compatible (stock macOS).
set -eu

CONF_DIR="${AGENTVM_HOME:-$HOME/.agentvm}"
CONF_FILE="$CONF_DIR/config"
SSH_CONF="$CONF_DIR/ssh_config"
[ -f "$CONF_FILE" ] && . "$CONF_FILE"
HOST="${AGENTVM_HOST:-${HOST:-}}"   # ssh destination of the VM host, e.g. you@hornet (tailscale name)
HOST_BIN="${AGENTVM_HOST_BIN:-${HOST_BIN:-~/.local/bin/agentvm-host}}"

GRANTS_DIR="$CONF_DIR/grants"
TAB=$(printf '\t')
NL='
'

die() { echo "agentvm: $*" >&2; exit 1; }
warn() { echo "agentvm: $*" >&2; }
valid_vm() { case "${1:-}" in [a-z]*) ;; *) return 1 ;; esac; case "$1" in *[!a-z0-9-]*) return 1 ;; esac; [ ${#1} -le 31 ]; }
need_vm() { valid_vm "${1:-}" || die "invalid VM name: ${1:-}"; }
need_host() { [ -n "$HOST" ] || die "not configured; run: agentvm setup user@host"; }
h() { need_host; ssh -o LogLevel=ERROR "$HOST" "$HOST_BIN $*"; }
vm_ssh() { ssh -F "$SSH_CONF" "$@"; }
# Close the shared (ControlMaster) connection; required after revert/stop/rm or it points at a dead session.
drop_master() { [ -n "${1:-}" ] && ssh -F "$SSH_CONF" -O exit "$1.avm" >/dev/null 2>&1 || true; }
open_url() {
	if command -v open >/dev/null 2>&1 && [ "$(uname)" = Darwin ]; then open "$1"
	elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$1" >/dev/null 2>&1 &
	else echo "open: $1"; fi
}
free_port() { # start
	p=$1
	while (echo >/dev/tcp/127.0.0.1/$p) >/dev/null 2>&1; do p=$((p + 1)); done
	echo "$p"
}

write_ssh_config() {
	mkdir -p "$CONF_DIR"
	key="${IDENTITY:-}"
	{
		echo "# generated by agentvm setup — VMs are reached as <name>.avm through the host"
		# Per-VM ssh-agent grants survive setup regenerating this file. Never forward to the host.
		for gf in "$GRANTS_DIR"/*; do
			[ -f "$gf" ] || continue
			has_grant "${gf##*/}" ssh-agent || continue
			echo "Host ${gf##*/}.avm"
			echo "  ForwardAgent yes"
		done
		echo "Host *.avm"
		echo "  ForwardAgent no"
		echo "  User agent"
		echo "  ProxyCommand ssh -o LogLevel=ERROR $HOST $HOST_BIN connect %h %p"
		echo "  StrictHostKeyChecking no"
		echo "  UserKnownHostsFile /dev/null"
		echo "  LogLevel ERROR"
		echo "  ConnectTimeout 15"
		echo "  ServerAliveInterval 10"
		echo "  ServerAliveCountMax 3"
		echo "  ControlMaster auto"
		echo "  ControlPath $CONF_DIR/cm-%h"
		echo "  ControlPersist 10m"
		if [ -n "$key" ]; then echo "  IdentityFile $key"; fi
	} >"$SSH_CONF"
}

cmd_setup() {
	[ $# -ge 1 ] || die "usage: agentvm setup user@host [--key ~/.ssh/id_ed25519.pub]"
	HOST=$1; shift
	pub=""
	while [ $# -gt 0 ]; do case $1 in --key) pub=$2; shift 2 ;; *) die "unknown flag $1" ;; esac; done
	if [ -z "$pub" ]; then for k in "$HOME/.ssh/id_ed25519.pub" "$HOME/.ssh/id_ecdsa.pub" "$HOME/.ssh/id_rsa.pub"; do [ -f "$k" ] && { pub=$k; break; }; done; fi
	[ -f "$pub" ] || die "no ssh public key found; pass --key"
	IDENTITY=${pub%.pub}
	mkdir -p "$CONF_DIR"
	printf 'HOST=%q\nHOST_BIN=%q\nIDENTITY=%q\n' "$HOST" "$HOST_BIN" "$IDENTITY" >"$CONF_FILE"
	echo "==> checking ssh to $HOST"
	ssh -o LogLevel=ERROR "$HOST" "$HOST_BIN help >/dev/null" || die "cannot run $HOST_BIN on $HOST (is it installed? did you run agentvm-host init?)"
	echo "==> registering $pub with host (applies to VMs created from now on)"
	ssh -o LogLevel=ERROR "$HOST" "$HOST_BIN add-key" <"$pub"
	write_ssh_config
	if [ -f "$HOME/.ssh/config" ] && grep -qF "Include $SSH_CONF" "$HOME/.ssh/config"; then :; else
		echo "==> add this line to the TOP of ~/.ssh/config so 'ssh NAME.avm', VS Code, Zed etc. work:"
		echo "    Include $SSH_CONF"
	fi
	echo "==> done. Try: agentvm new demo"
}

cmd_attach() { # NAME [pi|opencode|shell] [session]
	name=$1; tool=${2:-pi}; sess=${3:-$tool}
	case $tool in
	pi) run='pi' ;;
	opencode) run='opencode' ;;
	shell) run='bash -l' ;;
	*) run=$tool ;;
	esac
	if has_pushed_grants "$name"; then grants_apply "$name" --quiet || true; fi
	# tmux keeps the agent alive when you disconnect (laptop sleep, network change).
	vm_ssh -t "$name.avm" "cd ~/project 2>/dev/null; tmux has-session -t '$sess' 2>/dev/null || tmux new-session -d -s '$sess' -c ~/project \"bash -lc '$run; exec bash -l'\"; exec tmux attach -t '$sess'"
}

cmd_desktop() { # NAME [--no-open]
	name=$1; noopen=${2:-}
	port=$(free_port 16080)
	url="http://127.0.0.1:$port/vnc.html?autoconnect=1&resize=remote&reconnect=1"
	echo "==> desktop for $name at $url  (Ctrl-C to close the tunnel)"
	[ "$noopen" = "--no-open" ] || (sleep 1.5; open_url "$url") &
	exec ssh -F "$SSH_CONF" -N -o ControlMaster=no -o ControlPath=none -o ExitOnForwardFailure=yes -L "127.0.0.1:$port:127.0.0.1:6080" "$name.avm"
}

cmd_forward() { # NAME PORT [LOCALPORT]
	name=$1; rport=$2; lport=${3:-$2}
	echo "==> localhost:$lport -> $name:$rport  (Ctrl-C to stop)"
	exec ssh -F "$SSH_CONF" -N -o ControlMaster=no -o ControlPath=none -o ExitOnForwardFailure=yes -L "127.0.0.1:$lport:127.0.0.1:$rport" "$name.avm"
}

# ---------------------------------------------------------------- grants
# Per-VM, user-approved access to things on this machine. Stored locally (names/paths only, never
# values) in ~/.agentvm/grants/NAME as "kind<TAB>key<TAB>extra" lines:
#   ssh-agent                     forward the local ssh agent (ForwardAgent for NAME.avm only)
#   env   NAME   [command]        export NAME in the VM; value from the local env, or from `command`
#   file  /abs/local  remote      copy a local file into the VM (tmpfs), symlinked at `remote`
# env/file values are pushed over ssh into /run/user/<uid>/agentvm (tmpfs, gone on reboot) whenever
# grants are applied: on grant/revoke, new, start, revert, attach, ssh, and by the pi extension.

grant_file() { echo "$GRANTS_DIR/$1"; }
has_grant() { [ -f "$(grant_file "$1")" ] && awk -F'\t' -v k="$2" '$1==k{f=1} END{exit !f}' "$(grant_file "$1")"; }
has_pushed_grants() { [ -f "$(grant_file "$1")" ] && awk -F'\t' '$1=="env"||$1=="file"{f=1} END{exit !f}' "$(grant_file "$1")"; }

grant_put() { # NAME kind key extra
	mkdir -p "$GRANTS_DIR"; chmod 700 "$GRANTS_DIR"
	f=$(grant_file "$1"); touch "$f"; tmp="$f.tmp.$$"
	awk -F'\t' -v k="$2" -v a="$3" '!($1==k && $2==a)' "$f" >"$tmp"
	printf '%s\t%s\t%s\n' "$2" "$3" "$4" >>"$tmp"
	mv "$tmp" "$f"
}

grant_del() { # NAME kind key-or-remote → prints number removed
	f=$(grant_file "$1"); [ -f "$f" ] || { echo 0; return; }
	tmp="$f.tmp.$$"
	awk -F'\t' -v k="$2" -v a="$3" '($1==k && ($2==a || $3==a)){n++; next} {print} END{print n+0 > "/dev/stderr"}' "$f" 2>"$tmp.n" >"$tmp"
	mv "$tmp" "$f"; [ -s "$f" ] || rm -f "$f"
	cat "$tmp.n"; rm -f "$tmp.n"
}

abs_path() { # resolve a local path (file must exist)
	[ -e "$1" ] || die "no such local file: $1"
	d=$(cd "$(dirname "$1")" && pwd) || die "cannot resolve $1"
	echo "$d/$(basename "$1")"
}

# grant_spec NAME SPEC [CMD] [dry]: validate (and unless dry, store) one grant.
#   ssh-agent | env:VAR | file:LOCAL[=REMOTE]   (REMOTE default: project/<basename>, relative to /home/agent)
grant_spec() {
	n=$1; spec=$2; cmd=${3:-}; dry=${4:-}
	case $spec in
	ssh-agent)
		[ -z "$cmd" ] || die "--cmd only applies to env grants"
		[ -n "$dry" ] || grant_put "$n" ssh-agent "" "" ;;
	env:*)
		var=${spec#env:}
		case $var in [A-Za-z_]*) ;; *) die "invalid env var name: $var" ;; esac
		case $var in *[!A-Za-z0-9_]*) die "invalid env var name: $var" ;; esac
		case $cmd in *"$TAB"* | *"$NL"*) die "--cmd must be a single line" ;; esac
		[ -n "$dry" ] || grant_put "$n" env "$var" "$cmd" ;;
	file:*)
		rest=${spec#file:}; loc=${rest%%=*}; rem=""
		case $rest in *=*) rem=${rest#*=} ;; esac
		[ -n "$loc" ] || die "usage: file:LOCAL[=REMOTE]"
		abs=$(abs_path "$loc"); [ -f "$abs" ] || die "not a regular file: $loc"
		[ "$(wc -c <"$abs")" -le 1048576 ] || die "file grants are limited to 1 MiB: $loc"
		[ -n "$rem" ] || rem="project/$(basename "$abs")"
		case "/$rem/" in */../* | *"$TAB"* | *"$NL"*) die "invalid remote path: $rem" ;; esac
		case "$abs" in *"$TAB"* | *"$NL"*) die "invalid local path: $abs" ;; esac
		[ -n "$dry" ] || grant_put "$n" file "$abs" "$rem" ;;
	*) die "unknown grant '$spec' (use ssh-agent, env:VAR or file:LOCAL[=REMOTE])" ;;
	esac
}

grants_summary() { # NAME → "ssh-agent,env:X,file:project/.env"
	f=$(grant_file "$1"); [ -f "$f" ] || { echo "-"; return; }
	awk -F'\t' '{ s = ($1=="ssh-agent") ? "ssh-agent" : ($1=="env") ? "env:" $2 : "file:" $3; out = out (out ? "," : "") s } END{print out ? out : "-"}' "$f"
}

env_value() { # VAR CMD → value on stdout
	if [ -n "${2:-}" ]; then
		v=$(sh -c "$2") || { warn "grant env:$1: command failed: $2"; return 1; }
	else
		v=$(printenv "$1" 2>/dev/null || true)
	fi
	[ -n "$v" ] || { warn "grant env:$1: no value on this machine (set it, or: agentvm grant VM env:$1 --cmd '...'); skipped"; return 1; }
	printf '%s' "$v"
}

# Script run in the VM (stdin of `bash -s`): reconciles the tmpfs state to exactly the current grants.
build_apply_script() {
	f=$(grant_file "$1")
	cat <<'EOF'
set -eu
umask 077
RT=${AGENTVM_RUNTIME_DIR:-/run/user/$(id -u)}
for _ in $(seq 30); do [ -d "$RT" ] && break; sleep 1; done   # appears once the user manager is up (lingering)
[ -d "$RT" ] || { echo "agentvm: $RT missing (no user runtime dir)" >&2; exit 1; }
R=$RT/agentvm
mkdir -p "$R/files"
: >"$R/env.sh.new"; : >"$R/links.new"; : >"$R/targets.new"
put_env() { v=$(printf %s "$2" | base64 -d); printf 'export %s=%q\n' "$1" "$v" >>"$R/env.sh.new"; }
put_file() {
	d=$1; case "$d" in /*) ;; *) d=$HOME/$d ;; esac
	case "/$d/" in */../*) echo "agentvm: refusing path with ..: $d" >&2; return 0 ;; esac
	case "$d" in "$HOME"/*) ;; *) echo "agentvm: refusing file grant outside $HOME: $d" >&2; return 0 ;; esac
	t=$R/files/$(printf %s "$d" | cksum | cut -d' ' -f1)
	rm -f "$t"; printf %s "$2" | base64 -d >"$t"; chmod 0400 "$t"
	echo "$t" >>"$R/targets.new"
	if [ -e "$d" ] && [ ! -L "$d" ]; then echo "agentvm: $d exists as a real file; not replacing it" >&2; return 0; fi
	mkdir -p "$(dirname "$d")"; ln -sfn "$t" "$d"; echo "$d" >>"$R/links.new"
	case "$d" in "$HOME"/project/*)
		if [ -d "$HOME/project/.git" ]; then
			ex=$HOME/project/.git/info/exclude; rel=/${d#"$HOME"/project/}
			mkdir -p "$(dirname "$ex")"; touch "$ex"; grep -qxF "$rel" "$ex" || echo "$rel" >>"$ex"
		fi ;;
	esac
}
EOF
	if [ -f "$f" ]; then
		while IFS="$TAB" read -r kind a b; do
			case $kind in
			env) v=$(env_value "$a" "$b") || continue
				printf 'put_env %s %s\n' "$a" "$(printf %s "$v" | base64 | tr -d '\n')" ;;
			file) [ -r "$a" ] || { warn "grant file:$a: not readable; skipped"; continue; }
				printf 'put_file %s %s\n' "$(printf %q "$b")" "$(base64 <"$a" | tr -d '\n')" ;;
			esac
		done <"$f"
	fi
	cat <<'EOF'
mv "$R/env.sh.new" "$R/env.sh"
if [ -f "$R/links" ]; then
	while IFS= read -r old; do
		grep -qxF "$old" "$R/links.new" && continue
		if [ -L "$old" ]; then case "$(readlink "$old")" in "$R"/*) rm -f "$old" ;; esac; fi
	done <"$R/links"
fi
mv "$R/links.new" "$R/links"
for t in "$R"/files/*; do [ -e "$t" ] || continue; grep -qxF "$t" "$R/targets.new" || rm -f "$t"; done
rm -f "$R/targets.new"
hook='[ -r "/run/user/$(id -u)/agentvm/env.sh" ] && . "/run/user/$(id -u)/agentvm/env.sh"  # agentvm-grants'
for rc in "$HOME/.profile" "$HOME/.bashrc"; do
	touch "$rc"
	grep -q 'agentvm-grants' "$rc" || { printf '%s\n' "$hook" | cat - "$rc" >"$rc.agentvm" && cat "$rc.agentvm" >"$rc" && rm -f "$rc.agentvm"; }
done
echo "agentvm: grants applied ($(grep -c . "$R/env.sh" || true) env, $(grep -c . "$R/links" || true) files)"
EOF
}

grants_apply() { # NAME [--quiet]
	out=$(build_apply_script "$1" | vm_ssh "$1.avm" 'bash -s' 2>&1) || { warn "could not apply grants to $1: $out"; return 1; }
	[ "${2:-}" = --quiet ] || echo "==> $out"
}

# After a grant change: regenerate ForwardAgent config, stop the shared connection from taking new
# sessions (running ones finish; the next connection uses the new config), push env/file state.
grants_changed() {
	write_ssh_config
	ssh -F "$SSH_CONF" -O stop "$1.avm" >/dev/null 2>&1 || true
	grants_apply "$1" || warn "grants for $1 are saved; they'll be applied on the next start/attach"
}

cmd_grant() { # NAME SPEC... [--cmd CMD]
	need_host; need_vm "${1:-}"; n=$1; shift
	[ $# -gt 0 ] || die "usage: agentvm grant NAME ssh-agent | env:VAR [--cmd CMD] | file:LOCAL[=REMOTE] ..."
	while [ $# -gt 0 ]; do
		spec=$1; shift; cmd=""
		if [ "${1:-}" = --cmd ]; then cmd=${2:-}; shift 2 || die "--cmd needs a value"; fi
		grant_spec "$n" "$spec" "$cmd"
		echo "==> granted $spec to $n"
	done
	case $(grants_summary "$n") in *ssh-agent*) echo "==> note: processes in $n can use your ssh keys while you're connected. Trusted VMs only." ;; esac
	grants_changed "$n"
}

cmd_revoke() { # NAME SPEC...|all
	need_host; need_vm "${1:-}"; n=$1; shift
	[ $# -gt 0 ] || die "usage: agentvm revoke NAME ssh-agent | env:VAR | file:LOCAL-or-REMOTE | all"
	for spec in "$@"; do
		case $spec in
		all) rm -f "$(grant_file "$n")"; echo "==> revoked all grants for $n" ;;
		ssh-agent) [ "$(grant_del "$n" ssh-agent "")" -gt 0 ] && echo "==> revoked ssh-agent" || warn "no ssh-agent grant" ;;
		env:*) [ "$(grant_del "$n" env "${spec#env:}")" -gt 0 ] && echo "==> revoked $spec" || warn "no grant $spec" ;;
		file:*) k=${spec#file:}; [ -e "$k" ] && k=$(abs_path "$k")
			[ "$(grant_del "$n" file "$k")" -gt 0 ] && echo "==> revoked $spec" || warn "no grant $spec" ;;
		*) die "unknown grant '$spec'" ;;
		esac
	done
	grants_changed "$n"
}

cmd_grants() { # NAME [apply [--quiet]]
	need_vm "${1:-}"; n=$1
	if [ "${2:-}" = apply ]; then need_host; grants_apply "$n" "${3:-}"; return; fi
	f=$(grant_file "$n")
	[ -f "$f" ] || { echo "no grants for $n"; return; }
	echo "grants for $n (values are read from this machine when applied; never stored):"
	while IFS="$TAB" read -r kind a b; do
		case $kind in
		ssh-agent) echo "  ssh-agent   forward your local ssh agent" ;;
		env) echo "  env:$a${b:+   (from: $b)}" ;;
		file) echo "  file:$a → /home/agent/${b#/home/agent/}" ;;
		esac
	done <"$f"
}

cmd_agent_forward() { # NAME on|off  (alias for grant/revoke ssh-agent)
	[ $# -eq 2 ] || die "usage: agentvm agent-forward NAME on|off"
	case $2 in
	on) cmd_grant "$1" ssh-agent ;;
	off) need_host; need_vm "$1"; grant_del "$1" ssh-agent "" >/dev/null; echo "==> agent forwarding off for $1"; grants_changed "$1" ;;
	*) die "usage: agentvm agent-forward NAME on|off" ;;
	esac
}

migrate_legacy_agent_forward() { # ~/.agentvm/agent-forward/NAME markers → grants
	[ -d "$CONF_DIR/agent-forward" ] || return 0
	for m in "$CONF_DIR"/agent-forward/*; do
		[ -f "$m" ] || continue
		valid_vm "${m##*/}" && grant_put "${m##*/}" ssh-agent "" ""
	done
	rm -rf "$CONF_DIR/agent-forward"
	[ -n "$HOST" ] && write_ssh_config || true
}

cmd_new() { # NAME [--cpus N --mem MiB --disk GiB] [--grant SPEC]... [--agent-forward]
	name=""; pass=""; specs=""
	while [ $# -gt 0 ]; do
		case $1 in
		--grant) [ $# -ge 2 ] || die "--grant needs a value"; specs="$specs$2$NL"; shift 2 ;;
		--agent-forward) specs="${specs}ssh-agent$NL"; shift ;;
		--cpus | --mem | --disk) [ $# -ge 2 ] || die "$1 needs a value"; pass="$pass $1 $(printf %q "$2")"; shift 2 ;;
		-*) die "unknown flag $1" ;;
		*) name=$1; shift ;;
		esac
	done
	need_vm "$name"
	# validate grants before creating anything
	while IFS= read -r sp; do [ -n "$sp" ] && grant_spec "$name" "$sp" "" dry; done <<EOF
$specs
EOF
	h new "$name" $pass
	if [ -n "$specs" ]; then
		while IFS= read -r sp; do [ -n "$sp" ] && grant_spec "$name" "$sp" ""; done <<EOF
$specs
EOF
		echo "==> grants for $name: $(grants_summary "$name")"
		grants_changed "$name"
	fi
}

cmd_ls() {
	out=$(h ls) || exit $?
	printf '%s\n' "$out" | while IFS= read -r line; do
		n=${line%% *}
		if [ "$n" = NAME ]; then printf '%-62s %s\n' "$line" GRANTS
		else printf '%-62s %s\n' "$line" "$(grants_summary "$n")"; fi
	done
}

cmd_sessions() { vm_ssh "$1.avm" 'tmux ls 2>/dev/null || echo "(no tmux sessions)"'; }

cmd_prompt() { # NAME "prompt" — fire-and-forget pi task in a detached tmux window, logged to ~/project/.agentvm/
	name=$1; shift; prompt="$*"
	[ -n "$prompt" ] || die "usage: agentvm prompt NAME \"task...\""
	id=task-$(date +%Y%m%d-%H%M%S)
	b64=$(printf '%s' "$prompt" | base64 | tr -d '\n')
	# Ship the prompt base64-encoded and write a tiny runner script: no nested shell quoting.
	vm_ssh "$name.avm" "set -e; d=~/project/.agentvm; mkdir -p \$d; echo $b64 | base64 -d > \$d/$id.prompt
		printf '%s\n' '#!/bin/bash -l' 'cd ~/project' 'pi -p \"\$(cat .agentvm/$id.prompt)\" </dev/null 2>&1 | tee .agentvm/$id.log' 'echo \"[agentvm] task finished (exit \${PIPESTATUS[0]})\" | tee -a .agentvm/$id.log' 'exec bash -l' > \$d/$id.sh
		chmod +x \$d/$id.sh; tmux new-session -d -s $id -c ~/project \$d/$id.sh"
	echo "started $id on $name — watch: agentvm attach $name pi $id   log: agentvm run $name cat project/.agentvm/$id.log"
}

usage() {
	cat <<-'EOF'
		agentvm — remote desktop VMs for coding agents

		setup user@host [--key K.pub]   configure host + register your ssh key
		new NAME [--cpus N --mem MiB --disk GiB] [--grant SPEC]... [--agent-forward]
		ls                              list VMs (with their grants)
		rm NAME                         destroy VM (revokes its LLM token)
		start|stop NAME
		snap NAME [SNAP] | snaps NAME | revert NAME SNAP

		ssh NAME [cmd...]               shell into VM (also: ssh NAME.avm)
		run NAME cmd...                 run a command
		attach NAME [pi|opencode|shell] [session]
		                                attach to a persistent tmux session running the agent
		prompt NAME "task"              start a headless pi task in the background
		sessions NAME                   list tmux sessions
		desktop NAME [--no-open]        open the XFCE desktop in your browser (noVNC over ssh)
		forward NAME PORT [LOCAL]       forward a VM port to localhost
		grant NAME SPEC... [--cmd CMD]  give a VM access to something on this machine:
		                                  ssh-agent | env:VAR | file:LOCAL[=REMOTE]
		revoke NAME SPEC...|all         take it away (pushed values are deleted from the VM)
		grants NAME [apply]             show grants / push them again
		agent-forward NAME on|off       same as grant/revoke NAME ssh-agent
		proxy-log [N]                   recent LLM proxy requests on the host
	EOF
}

cmd=${1:-help}; [ $# -gt 0 ] && shift
migrate_legacy_agent_forward
case $cmd in
setup) cmd_setup "$@" ;;
rm) need_host; drop_master "${1:-}"; h rm "$@"; drop_master "${1:-}"; rm -f "$(grant_file "${1:-x}")"; write_ssh_config ;;
stop) need_host; drop_master "${1:-}"; h stop "$@"; drop_master "${1:-}" ;;
start) need_host; drop_master "${1:-}"; h start "$@"; drop_master "${1:-}"; if has_pushed_grants "${1:-x}"; then grants_apply "$1" || true; fi ;;
# a revert restores the snapshot's tmpfs too: always reconcile to the current grants
revert) need_host; drop_master "${1:-}"; h revert "$@"; drop_master "${1:-}"; grants_apply "$1" --quiet || true ;;
snap) need_host
	if has_pushed_grants "${1:-x}"; then warn "note: $1 has env/file grants; a memory snapshot includes their values (they are re-synced on revert)"; fi
	h snap "$@" ;;
new) need_host; cmd_new "$@" ;;
ls | list) need_host; cmd_ls ;;
snaps | proxy-log) need_host; h "$cmd" "$@" ;;
ssh) need_host; n=$1; shift; if has_pushed_grants "$n"; then grants_apply "$n" --quiet || true; fi; vm_ssh -t "$n.avm" "$@" ;;
run) need_host; n=$1; shift; vm_ssh "$n.avm" "$@" ;;
attach) need_host; cmd_attach "$@" ;;
desktop) need_host; cmd_desktop "$@" ;;
forward) need_host; cmd_forward "$@" ;;
grant) cmd_grant "$@" ;;
revoke) cmd_revoke "$@" ;;
grants) cmd_grants "$@" ;;
agent-forward) cmd_agent_forward "$@" ;;
sessions) need_host; cmd_sessions "$@" ;;
prompt) need_host; cmd_prompt "$@" ;;
help | -h | --help) usage ;;
*) usage; exit 1 ;;
esac
