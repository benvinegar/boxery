{
  "name": "boxery-vm",
  "version": "0.7.0",
  "description": "Self-hosted desktop VMs for coding agents; pi extension + MCP server give laptop agents vm_* tools",
  "keywords": ["pi-package", "mcp", "mcp-server", "vm", "computer-use", "coding-agent", "libvirt", "lima", "kvm"],
  "homepage": "https://github.com/benvinegar/boxery#readme",
  "bugs": { "url": "https://github.com/benvinegar/boxery/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/benvinegar/boxery.git" },
  "author": "Ben Vinegar",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20" },
  "os": ["linux", "darwin"],
  "bin": {
    "boxery": "controller/boxery",
    "boxery-host": "host/boxery-host",
    "boxery-mcp": "mcp/boxery-mcp.mjs",
    "boxery-vm": "mcp/boxery-mcp.mjs"
  },
  "files": [
    "controller/",
    "core/",
    "extension/",
    "host/",
    "image/",
    "mcp/boxery-mcp.mjs",
    "mcp/desktop-view.html",
    "proxy/",
    "docs/*.md",
    "ARCHITECTURE.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:shell": "bash test/shell/run.sh",
    "lint": "bash test/lint.sh",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": { "optional": true }
  },
  "pi": {
    "extensions": ["./extension/index.ts"],
    "image": "https://raw.githubusercontent.com/benvinegar/boxery/master/docs/computer-use.png"
  }
}
