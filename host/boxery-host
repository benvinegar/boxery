#!/usr/bin/env bash
# boxery-host: manage Ubuntu desktop VMs for coding agents.
# Runs on the VM host (Linux with libvirt, macOS/Linux with Lima, or anywhere with ssh for exe.dev). The
# controller (`boxery`) calls it over ssh, or directly when the controller runs on the host itself (HOST=local).
# VM-platform specifics live in host/backends/<backend>.sh (see host/backends/README.md).
set -euo pipefail

resolve() { local p=$1; while [ -L "$p" ]; do local t; t=$(readlink "$p"); case $t in /*) p=$t ;; *) p=$(dirname "$p")/$t ;; esac; done; echo "$p"; }  # macOS has no readlink -f
ROOT=$(cd "$(dirname "$(resolve "$0")")/.." && pwd)
CONF=${BOXERY_CONF:-$HOME/.config/boxery}
export CACHE=${BOXERY_CACHE:-$HOME/.cache/boxery}   # used by backends
# Settings persisted by `init` (backend, proxy port/unit). Explicit env vars win over the file.
if [ -f "$CONF/host.env" ]; then
	while IFS='=' read -r k v; do
		case $k in BOXERY_BACKEND | BOXERY_PROXY_PORT | BOXERY_PROXY_UNIT | BOXERY_POOL | BOXERY_POOL_DIR | BOXERY_BASE_VOL | BOXERY_DOMAIN_PREFIX | BOXERY_LIMA_PREFIX | BOXERY_CH_DIR | BOXERY_CH_NET | BOXERY_CH_DNS | BOXERY_CH_FIRMWARE | BOXERY_CH_SUDO | BOXERY_EXE_DIR | BOXERY_EXE_PREFIX | BOXERY_EXE_KEY | BOXERY_EXE_PORT_BASE | BOXERY_EXE_GUEST_PORT | BOXERY_EXE_EGRESS | BOXERY_EXE_POOL | BOXERY_EXE_MAX_CPUS | BOXERY_EXE_MAX_MEM) [ -n "${!k:-}" ] || export "$k=$v" ;; esac
	done <"$CONF/host.env"
fi
PROXY_PORT=${BOXERY_PROXY_PORT:-8088}
BACKEND=${BOXERY_BACKEND:-libvirt}
PROXY_UNIT=${BOXERY_PROXY_UNIT:-boxery-proxy}   # override to run a second boxery install side by side
SSH_OPTS=(-o IdentitiesOnly=yes -o IdentityFile="${BOXERY_CONF:-$HOME/.config/boxery}/mgmt_ed25519" -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ConnectTimeout=5)

die() { echo "boxery-host: $*" >&2; exit 1; }
log() { echo "==> $*" >&2; }
need() { command -v "$1" >/dev/null || die "missing dependency: $1"; }
valid_name() { [[ $1 =~ ^[a-z][a-z0-9-]{0,30}$ ]] || die "invalid name '$1' (use [a-z][a-z0-9-]*)"; }
valid_snap() { [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || die "invalid snapshot name '$1'"; }
valid_num() { [[ $2 =~ ^[0-9]+$ ]] || die "$1 must be a number"; }
# Images are immutable disk states, named VM@LABEL: snapshots (`snap demo s1` → demo@s1), the pool's
# clean state (NAME@boxery-clean) and short-lived fork sources (SRC@fork-…). See host/backends/README.md.
valid_image() { [[ $1 =~ ^[a-z][a-z0-9-]{0,30}@[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || die "invalid image name '$1'"; }
image_exists() { backend_images | cut -f1 | grep -xF "$1" >/dev/null; }   # not grep -q: an early exit + pipefail = false negative
MGMT_KEY=$CONF/mgmt_ed25519   # host's own passwordless key for managing VMs (works without an ssh-agent)
host_pubkey() {
	[[ -f $MGMT_KEY ]] || ssh-keygen -q -t ed25519 -N "" -C "boxery-host@$(hostname)" -f "$MGMT_KEY"
	cat "$MGMT_KEY.pub"
}


vm_ssh_cmd() { local h=$1 p=$2; shift 2; ssh "${SSH_OPTS[@]}" -p "$p" "agent@$h" "$@"; }

wait_ssh() { # HOST [PORT]   (tries × 2s; BOXERY_SSH_WAIT_TRIES, default 180 = 6 min)
	for _ in $(seq "${BOXERY_SSH_WAIT_TRIES:-180}"); do ssh "${SSH_OPTS[@]}" -p "${2:-22}" "agent@$1" true 2>/dev/null && return; sleep 2; done
	die "timed out waiting for ssh on $1:${2:-22}"
}

load_backend() {
	local f="$ROOT/host/backends/$BACKEND.sh"
	[[ -f $f ]] || die "unknown backend '$BACKEND' (have: $(ls "$ROOT/host/backends" | sed -n 's/\.sh$//p' | tr '\n' ' '))"
	# shellcheck source=/dev/null
	. "$f"
}
ensure_tokens() { mkdir -p "$CONF"; chmod 700 "$CONF"; [[ -f $CONF/tokens.json ]] || echo '{}' >"$CONF/tokens.json"; chmod 600 "$CONF/tokens.json"; }

# Node owns the short token read/modify/rename transaction; no mkdir lock survives a crash.
operations() { BOXERY_BACKEND=$BACKEND node --disable-warning=ExperimentalWarning "$ROOT/host/boxery-operations.mjs" "$1" "$CONF" "${@:2}"; }
token_set() { operations token set "$1" "$2"; }
token_del() { operations token del "$1"; }
intent() { operations intent "$@"; }
intent_done() { operations 'done' "$1"; }

# Per-VM identity as cloud-config user-data (keys, proxy token, agent configs). Backend-agnostic.
# shellcheck disable=SC2034  # pi_models/pi_settings/oc_config are read indirectly via ${!var}
boxery_seed() { # NAME → path of a user-data file
	local name=$1 tmp=$CONF/work/$BOXERY_OPERATION_ID/$1
	mkdir -p "$tmp"; chmod 700 "$CONF/work" "$CONF/work/$BOXERY_OPERATION_ID" "$tmp"
	local secret
	secret=$(openssl rand -hex 24) && [[ ${#secret} -eq 48 ]] || die "could not generate a proxy token (is openssl installed?)"
	token_set "$name" "$secret"
	local cred="$name:$secret"
	# The Codex client derives an account id from a JWT, so hand it an unsigned JWT that carries our token.
	local fakejwt; fakejwt=$(node -e 'const b=o=>Buffer.from(JSON.stringify(o)).toString("base64url");
		console.log(b({alg:"none",typ:"JWT"})+"."+b({boxery:process.argv[1],"https://api.openai.com/auth":{chatgpt_account_id:"boxery"}})+".boxery")' "$cred")
	local ollama_models; ollama_models=$(curl -fsS -m 3 127.0.0.1:11434/api/tags 2>/dev/null | jq -c '[.models[] | select(.capabilities|index("tools")) | {id:.name}]' 2>/dev/null || echo '[]')
	local P="http://127.0.0.1:8088"   # in the guest, socat always listens here and forwards to the host proxy

	local pi_models pi_settings oc_config
	pi_models=$(jq -n --arg jwt "$fakejwt" --arg cred "$cred" --arg p "$P" --argjson om "$ollama_models" '{
		providers: ({
			"openai-codex": {baseUrl: ($p + "/chatgpt/backend-api"), apiKey: $jwt}
		} + (if ($om|length) > 0 then {ollama: {baseUrl: ($p + "/ollama/v1"), api: "openai-completions", apiKey: $cred, models: $om}} else {} end))}')
	pi_settings=$(jq -n '{transport: "sse", defaultProvider: "openai-codex", defaultModel: "gpt-6.1-sol", defaultThinkingLevel: "medium"}')
	local oc_models oc_default
	oc_models=$(jq -c '[.[] | {key: .id, value: {name: .id}}] | from_entries' <<<"$ollama_models")
	oc_default=$(jq -r 'map(.id) | (if index("qwen3-coder:latest") then "qwen3-coder:latest" else .[0] end) // empty' <<<"$ollama_models")
	oc_config=$(jq -n --arg cred "$cred" --arg p "$P" --argjson m "$oc_models" --arg def "$oc_default" '{
		"$schema": "https://opencode.ai/config.json",
		autoupdate: false,
		provider: {boxery: {npm: "@ai-sdk/openai-compatible", name: "boxery host proxy (ollama)",
			options: {baseURL: ($p + "/ollama/v1"), apiKey: $cred}, models: $m}}
	} + (if $def != "" then {model: ("boxery/" + $def)} else {} end)')

	local keys; keys=$( { host_pubkey; cat "$CONF/authorized_keys" 2>/dev/null; } | sort -u | grep -v '^$')
	{
		echo "#cloud-config"
		echo "hostname: $name"
		echo "fqdn: $name.boxery"
		echo "ssh_pwauth: false"
		echo "ssh_authorized_keys:"
		while IFS= read -r k; do printf '  - %s\n' "$(jq -Rn --arg k "$k" '$k')"; done <<<"$keys"
		# First boot of this instance (also when the disk came from another VM: fork): start with no
		# authorized keys (cloud-init's ssh module merges into the existing file, and a fork's disk carries
		# its source's keys) and a fresh machine-id. bootcmd runs before sshd starts.
		echo "bootcmd:"
		echo "  - [cloud-init-per, instance, boxery-keys, sh, -c, 'rm -f /home/agent/.ssh/authorized_keys']"
		echo "  - [cloud-init-per, instance, boxery-machine-id, sh, -c, 'rm -f /etc/machine-id /var/lib/dbus/machine-id; systemd-machine-id-setup >/dev/null']"
		echo "write_files:"
		printf '  - path: /etc/boxery/proxy-upstream\n    content: %s\n' "$(guest_proxy_upstream)"
		for pair in ".pi/agent/models.json:pi_models" ".pi/agent/settings.json:pi_settings" ".config/opencode/opencode.json:oc_config" ".boxery/token:cred"; do
			local f=${pair%%:*} var=${pair##*:}
			printf '  - path: /home/agent/%s\n    owner: agent:agent\n    permissions: "0600"\n    defer: true\n    encoding: b64\n    content: %s\n' \
				"$f" "$(printf '%s' "${!var}" | base64 | tr -d '\n')"
		done
		cat <<-'EOF'
			runcmd:
			  - [bash, -c, "[ -e /etc/agentvm ] || ln -s /etc/boxery /etc/agentvm; systemctl restart boxery-llm.service 2>/dev/null || systemctl restart agentvm-llm.service"]  # agentvm-*: pre-rename images
			  - [bash, -c, "chown -R agent:agent /home/agent && sudo -u agent bash -lc 'git config --global user.name agent; git config --global user.email agent@boxery; git config --global init.defaultBranch main; mkdir -p ~/project && cd ~/project && git init -q'"]
		EOF
	} >"$tmp/user-data"
	echo "$tmp/user-data"
}

# ---------------------------------------------------------------- leases (pool VMs)
# State machine + fencing live in host/boxery-leases.mjs (SQLite). This file does the side effects:
# installing a lease's ssh key in the VM, and resetting the VM to its clean image (NAME@boxery-clean).

POOL_SNAP=boxery-clean
leases() { node --disable-warning=ExperimentalWarning "$ROOT/host/boxery-leases.mjs" "$CONF/leases.db" "$@"; }
is_pool() { # 0 = pool VM, 1 = not; dies on a lease-store error rather than guessing
	local r; r=$(leases get "$1") || die "lease store error"
	[[ $r != null ]]
}

# authorized_keys in the VM := host management key (+ the lease holder's key). This is the fence:
# a VM in the pool accepts nobody else, and resetting it (reimage from its clean image) drops the lease key again.
lease_set_keys() { # NAME [PUBKEY]
	local ep h p; ep=$(backend_ssh_endpoint "$1"); h=${ep% *}; p=${ep#* }
	{ host_pubkey; [[ -z ${2:-} ]] || printf '%s\n' "$2"; } |
		vm_ssh_cmd "$h" "$p" 'umask 077; mkdir -p ~/.ssh && cat >~/.ssh/authorized_keys.boxery && mv ~/.ssh/authorized_keys.boxery ~/.ssh/authorized_keys'
}

# ---------------------------------------------------------------- JSON output (stable fields: docs/cli.md)
# Arrays are printed one element per line ("[", "{…},", …, "]"): still plain JSON, and the controller
# (which has no jq) relies on it to add local fields to each element.
JSON_ARRAY='if length == 0 then "[]" else "[\n" + (map(tojson) | join(",\n")) + "\n]" end'
pool_json() { leases list | jq -r "map({name, state, holder, acquired_at, expires_at, expires_in}) | $JSON_ARRAY"; }
ls_json() { # backend_list (NAME<TAB>STATE<TAB>ADDR<TAB>DISK) + lease state → [{name,state,addr,disk,lease}]
	local pool; pool=$(leases list 2>/dev/null) || pool=""; [[ -n $pool ]] || pool='[]'
	backend_list | jq -R -s -r --argjson pool "$pool" '
		def nz: if . == null or . == "" then null else . end;
		($pool | map({key: .name, value: {state, holder, expires_at}}) | from_entries) as $p |
		split("\n") | map(select(length > 0) | split("\t") |
			{name: .[0], state: (.[1] | nz), addr: (.[2] | nz), disk: (.[3] | nz), lease: ($p[.[0]] // null)}) | '"$JSON_ARRAY"
}
snaps_json() { # NAME → [{name, created, size, legacy}]   (cmd_snaps' tab lines)
	local lines; lines=$(snaps_lines "$1") || exit 1
	jq -R -s -r "split(\"\\n\") | map(select(length > 0) | split(\"\\t\") |
		{name: .[0], created: (if .[1] == \"(legacy)\" then null else .[1] end), size: (if .[2] == \"-\" then null else .[2] end), legacy: (.[1] == \"(legacy)\")}) | $JSON_ARRAY" <<<"$lines"
}

# Put VM NAME back to image IMAGE (its own snapshot or clean state). Pre-image VMs may still have a
# backend-internal snapshot of that label (libvirt: pool VMs added before images existed).
restore_vm() { # NAME LABEL
	if image_exists "$1@$2"; then backend_reimage "$1" "$1@$2"
	elif declare -F backend_legacy_revert >/dev/null && backend_legacy_revert "$1" "$2"; then :
	else die "no snapshot $2 for $1"; fi
}

# authorized_keys in a pet VM := host management key + every registered controller key.
pet_set_keys() { # NAME
	local ep h p; ep=$(backend_ssh_endpoint "$1"); h=${ep% *}; p=${ep#* }
	local keys; keys=$( { host_pubkey; cat "$CONF/authorized_keys" 2>/dev/null || true; } | sort -u | grep -v '^$' || true)
	printf '%s\n' "$keys" |
		vm_ssh_cmd "$h" "$p" 'umask 077; mkdir -p ~/.ssh && cat >~/.ssh/authorized_keys.boxery && mv ~/.ssh/authorized_keys.boxery ~/.ssh/authorized_keys'
}

# A stopped VM cannot receive keys. Defer that step until start; a running-but-unreachable
# guest is an error, not a successful permission update.
restore_pet_access() {
	local inventory state; inventory=$(backend_list) || die "cannot inspect VM for pet access"
	state=$(awk -F '\t' -v n="$1" '$1 == n {print $2}' <<<"$inventory")
	case $state in
	running|idle) pet_set_keys "$1" || die "could not restore pet access to $1" ;;
	esac
}

# RESETTING(gen) → reimage from the clean image → FREE (or BROKEN if anything fails).
lease_matches() { # NAME GEN EPOCH STATE: fail closed after taking the lifecycle lock
	local r; r=$(leases get "$1") || die "lease store error"
	jq -e --argjson gen "$2" --arg epoch "$3" --arg state "$4" '.gen == $gen and .epoch == $epoch and .state == $state' <<<"$r" >/dev/null
}
lease_reset() { with_vm_lock "$1" _lease_reset "$@"; }
_lease_reset() { # NAME GEN EPOCH (lock held through finish, readiness and key installation)
	local name=$1 gen=$2 epoch=$3 ok=0 ep h p action
	lease_matches "$name" "$gen" "$epoch" RESETTING || { log "$name: stale reset skipped"; return 0; }
	action=$(intent reset "$name" "$gen" "$epoch")
	edge_clear "$name"   # the next holder must not inherit this holder's credential routes
	# Every backend step runs in a subshell: backends `die` (exit) on failure, and a failed reset must
	# still reach the BROKEN transition below instead of leaving the row stuck in RESETTING.
	if ( restore_vm "$name" "$POOL_SNAP" ) 2>/dev/null; then
		ep=$( backend_wait_endpoint "$name" ) && h=${ep% *} && p=${ep#* } &&
			( BOXERY_SSH_WAIT_TRIES=${BOXERY_SSH_WAIT_TRIES:-45} wait_ssh "$h" "$p" ) 2>/dev/null &&
			vm_ssh_cmd "$h" "$p" "sudo date -u -s @$(date -u +%s) >/dev/null 2>&1; true" &&
			( lease_set_keys "$name" ) && ok=1
	fi
	if ((ok)); then
		leases finish "$name" "$gen" FREE >/dev/null || die "$name: reset commit failed"
		log "$name reset → FREE"
	else
		leases finish "$name" "$gen" BROKEN >/dev/null || die "$name: failed-reset commit failed"
		log "$name reset FAILED → BROKEN (fix it, then: boxery-host pool rm $name && boxery-host pool add $name)"
	fi
	intent_done "$action"
}

cmd_pool() { # add NAME | rm NAME [--force] | ls [--json]
	local sub=${1:-ls}; shift || true
	case $sub in
	add)
		valid_name "${1:-}"; backend_exists "$1" || die "no such vm: $1"
		is_pool "$1" && die "$1 is already in the pool"
		backend_ssh_endpoint "$1" >/dev/null   # must be running
		local ep h p action; ep=$(backend_ssh_endpoint "$1"); h=${ep% *}; p=${ep#* }
		action=$(intent pool-add "$1")
		# The clean snapshot must not carry a previous user's pushed grants (tmpfs) or keys.
		vm_ssh_cmd "$h" "$p" 'rm -rf "/run/user/$(id -u)/boxery"' || true
		lease_set_keys "$1" || die "could not lock down ssh keys on $1"
		# authorized_keys only gates *new* logins: end existing ssh sessions (not the desktop) so
		# nobody keeps access through a connection opened before the VM joined the pool.
		vm_ssh_cmd "$h" "$p" 'sudo pkill -u agent -x sshd 2>/dev/null; sudo pkill -f "^sshd: agent" 2>/dev/null; true' || true
		sleep 1
		vm_ssh_cmd "$h" "$p" 'sync' || true
		if image_exists "$1@$POOL_SNAP"; then backend_image_rm "$1@$POOL_SNAP"; fi
		if declare -F backend_legacy_snap_rm >/dev/null; then backend_legacy_snap_rm "$1" "$POOL_SNAP" || true; fi
		capture_vm "$1" "$1@$POOL_SNAP"
		leases add "$1" >/dev/null
		intent_done "$action"
		log "$1 added to the pool (only lease holders can reach it now)" ;;
	rm)
		valid_name "${1:-}"
		local row action; row=$(leases get "$1")
		[[ $row != null ]] || die "$1 is not a pool VM"
		[[ ${2:-} == --force ]] || jq -e '.state == "FREE" or .state == "BROKEN"' <<<"$row" >/dev/null || die "$1 is active; release it first (or --force)"
		action=$(intent pool-rm "$1")
		leases remove "$1" ${2:+"$2"} >/dev/null
		# back to a pet: registered controller keys may log in again
		restore_pet_access "$1"
		backend_cleanup_image "$1@$POOL_SNAP"
		intent_done "$action"
		log "$1 removed from the pool" ;;
	ls)
		local j; j=$(pool_json) || die "lease store error"
		if [[ ${1:-} == --json ]]; then printf '%s\n' "$j"; return; fi
		printf '%-16s %-10s %-10s %s\n' NAME LEASE EXPIRES HOLDER
		jq -r '.[] | [.name, .state, (if .expires_in then "\(.expires_in)s" else "-" end), (.holder // "-")] | @tsv' <<<"$j" |
			while IFS=$'\t' read -r n st ex ho; do printf '%-16s %-10s %-10s %s\n' "$n" "$st" "$ex" "$ho"; done ;;
	*) die "usage: pool add NAME | rm NAME [--force] | ls [--json]" ;;
	esac
}

cmd_acquire() { # --holder H [--ttl SECS] [--wait SECS]   (lease public key on stdin) → "NAME LEASE_ID EXPIRES_AT"
	local holder="" ttl=1800 wait=0
	while (($#)); do
		case $1 in
		--holder) holder=${2:-}; shift 2 ;;
		--ttl) valid_num "$1" "${2:-}"; ttl=$2; shift 2 ;;
		--wait) valid_num "$1" "${2:-}"; wait=$2; shift 2 ;;
		*) die "unknown flag $1" ;;
		esac
	done
	local pub; pub=$(head -n1)
	local deadline=$(($(date +%s) + wait)) claim="" reaped=0
	while :; do
		claim=$(leases claim "$holder" "$ttl" "$pub") || die "acquire failed"
		[[ $claim != null ]] && break
		if ((!reaped)); then reaped=1; cmd_reap >/dev/null 2>&1 || true; continue; fi   # free expired leases first
		(($(date +%s) < deadline)) || { echo "boxery-host: pool exhausted (no FREE VM)" >&2; exit 4; }
		sleep 2
	done
	local name gen lease exp
	name=$(jq -r .name <<<"$claim"); gen=$(jq -r .gen <<<"$claim"); lease=$(jq -r .lease_id <<<"$claim"); exp=$(jq -r .expires_at <<<"$claim")
	with_vm_lock "$name" _lease_acquire "$name" "$gen" "$(jq -r .epoch <<<"$claim")" "$pub"

	log "$name leased to $holder until $(date -d "@$exp" 2>/dev/null || date -r "$exp")"
	echo "$name $lease $exp"
}

_lease_acquire() { # NAME GEN EPOCH PUBKEY
	lease_matches "$1" "$2" "$3" ACQUIRING || die "lease on $1 changed while waiting for its lock"
	local action; action=$(intent acquire "$1" "$2" "$3")
	lease_set_keys "$1" "$4" || die "could not install the lease key on $1"
	leases commit "$1" "$2" >/dev/null || die "lease on $1 was fenced"
	intent_done "$action"
}

cmd_renew() { # LEASE_ID [--ttl SECS] → "NAME EXPIRES_AT"
	local id=${1:-} ttl=1800; [[ ${2:-} == --ttl ]] && { valid_num --ttl "${3:-}"; ttl=$3; }
	[[ $id =~ ^l-[0-9a-f]{32}$ ]] || die "invalid lease id"
	leases renew "$id" "$ttl" | jq -r '"\(.name) \(.expires_at)"'
}

cmd_release() { # LEASE_ID
	local id=${1:-}; [[ $id =~ ^l-[0-9a-f]{32}$ ]] || die "invalid lease id"
	local r; r=$(leases find "$id") || exit 2
	[[ $r != null ]] || die "unknown or inactive lease"
	with_vm_lock "$(jq -r .name <<<"$r")" _lease_release "$id"
}
_lease_release() {
	local r; r=$(leases begin-reset "$1") || return 2
	_lease_reset "$(jq -r .name <<<"$r")" "$(jq -r .gen <<<"$r")" "$(jq -r .epoch <<<"$r")"
}
_reap_candidate() { # NAME GEN EPOCH: deadline and generation are checked after locking
	local rows r; rows=$(leases due "$@")
	r=$(jq -c '.[0] // empty' <<<"$rows")
	[[ -n $r ]] || return 0
	log "reaping $1 ($(jq -r .reason <<<"$r"))"
	_lease_reset "$1" "$(jq -r .gen <<<"$r")" "$(jq -r .epoch <<<"$r")"
}
cmd_reap() {
	operations reconcile "$0"
	local rows; rows=$(leases candidates) || return 1
	jq -c '.[]' <<<"$rows" | while read -r r; do
		with_vm_lock "$(jq -r .name <<<"$r")" _reap_candidate "$(jq -r .name <<<"$r")" "$(jq -r .gen <<<"$r")" "$(jq -r .epoch <<<"$r")"
	done
	_reconcile_drift
}

# Durable intent handlers run under the original operation's complete lock set. Only artifacts
# named by that journal are removed: an unfamiliar VM or snapshot is never guessed to be garbage.
capture_vm() { # NAME IMAGE
	local state action
	state=$(backend_list | awk -F '\t' -v n="$1" '$1 == n {print $2}')
	action=$(intent capture "$1" "$2" "$state")
	backend_capture "$1" "$2"
	intent_done "$action"
}
recover_operation() {
	local entries entry id kind data name gen epoch r
	entries=$(operations intents)
	while IFS= read -r entry; do
		id=$(jq -r .id <<<"$entry"); kind=$(jq -r .kind <<<"$entry"); data=$(jq -c .data <<<"$entry")
		name=$(jq -r '.[0]' <<<"$data")
		case $kind in
		create)
			backend_cleanup_new "$name"
			token_del "$name"; edge_clear "$name" ;;
		remove)
			backend_cleanup_new "$name"
			# rm can have crashed between deleting the VM and deleting its images.
			cleanup_vm_images "$name"
			token_del "$name"; edge_clear "$name" ;;
		capture) backend_recover_capture "$name" "$(jq -r '.[1]' <<<"$data")" "$(jq -r '.[2]' <<<"$data")" ;;
		fork-image) backend_cleanup_image "$name" ;;
		snapshot-remove) _delete_snapshot "$name" "$(jq -r '.[1]' <<<"$data")" ;;
		revert) _revert "$name" "$(jq -r '.[1]' <<<"$data")" ;;
		acquire)
			gen=$(jq -r '.[1]' <<<"$data"); epoch=$(jq -r '.[2]' <<<"$data")
			if lease_matches "$name" "$gen" "$epoch" ACQUIRING; then
				r=$(leases begin-reset-name "$name" "$gen")
				_lease_reset "$name" "$(jq -r .gen <<<"$r")" "$epoch"
			fi ;;
		reset) _lease_reset "$name" "$(jq -r '.[1]' <<<"$data")" "$(jq -r '.[2]' <<<"$data")" ;;
		pool-add)
			if ! is_pool "$name"; then
				backend_cleanup_image "$name@$POOL_SNAP"
				pet_set_keys "$name"
			fi ;;
		pool-rm)
			if is_pool "$name"; then leases remove "$name" --force >/dev/null; fi
			restore_pet_access "$name"
			backend_cleanup_image "$name@$POOL_SNAP" ;;
		*) die "unknown recovery intent: $kind" ;;
		esac
		intent_done "$id"
	done < <(jq -c '.[]' <<<"$entries")
}
_reconcile_vm() {
	local inventory row
	inventory=$(backend_list) || die "cannot read backend inventory; refusing drift repair"
	if ! awk -F '\t' -v n="$1" '$1 == n { found=1 } END { exit !found }' <<<"$inventory"; then
		row=$(leases get "$1") || return 1
		if [[ $row != null ]]; then leases missing "$1" >/dev/null; log "$1 missing from backend → BROKEN"; fi
		token_del "$1"; edge_clear "$1"
	fi
}
_reconcile_drift() {
	local inventory rows tokens names name
	inventory=$(backend_list) || die "cannot read backend inventory; refusing drift repair"
	rows=$(leases list) || return 1
	tokens='{}'; [[ ! -f $CONF/tokens.json ]] || tokens=$(cat "$CONF/tokens.json")
	names=$( { printf '%s\n' "$inventory" | cut -f1; jq -r '.[].name' <<<"$rows"; jq -r 'keys[]' <<<"$tokens"; } | sort -u)
	while IFS= read -r name; do
		[[ -n $name ]] || continue
		valid_name "$name"
		with_vm_lock "$name" _reconcile_vm "$name"
	done <<<"$names"
}

# ---------------------------------------------------------------- commands

# LLM proxy + backend's guest bridge: systemd user units on Linux, launchd agents on macOS.
start_proxy_services() {
	local node; node=$(command -v node)
	if [[ $(uname) == Darwin ]]; then
		mkdir -p "$HOME/Library/LaunchAgents" "$HOME/Library/Logs"
		local plist=$HOME/Library/LaunchAgents/dev.$PROXY_UNIT.plist
		cat >"$plist" <<-EOF
			<?xml version="1.0" encoding="UTF-8"?>
			<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
			<plist version="1.0"><dict>
			  <key>Label</key><string>dev.$PROXY_UNIT</string>
			  <key>ProgramArguments</key><array><string>$node</string><string>$ROOT/proxy/boxery-proxy.mjs</string></array>
			  <key>EnvironmentVariables</key><dict><key>BOXERY_PROXY_PORT</key><string>$PROXY_PORT</string><key>BOXERY_PROXY_BIND</key><string>$(proxy_bind)</string><key>BOXERY_CONF</key><string>$CONF</string></dict>
			  <key>KeepAlive</key><true/><key>RunAtLoad</key><true/>
			  <key>StandardOutPath</key><string>$HOME/Library/Logs/$PROXY_UNIT.log</string>
			  <key>StandardErrorPath</key><string>$HOME/Library/Logs/$PROXY_UNIT.log</string>
			</dict></plist>
		EOF
		launchctl bootout "gui/$(id -u)/dev.$PROXY_UNIT" 2>/dev/null || true
		launchctl bootstrap "gui/$(id -u)" "$plist"
	else
		mkdir -p "$HOME/.config/systemd/user"
		cat >"$HOME/.config/systemd/user/$PROXY_UNIT.service" <<-EOF
			[Unit]
			Description=boxery LLM proxy (per-VM tokens -> host credentials)
			[Service]
			Environment=BOXERY_PROXY_PORT=$PROXY_PORT
			Environment=BOXERY_PROXY_BIND=$(proxy_bind)
			Environment=BOXERY_CONF=$CONF
			ExecStart=$node $ROOT/proxy/boxery-proxy.mjs
			Restart=always
			RestartSec=2
			[Install]
			WantedBy=default.target
		EOF
		local extra; extra=$(backend_proxy_services)
		systemctl --user daemon-reload
		systemctl --user enable --now "$PROXY_UNIT.service" $extra >/dev/null
		systemctl --user restart "$PROXY_UNIT.service" $extra
	fi
	sleep 1
}
# Reaper: resets expired/orphaned leases every minute.
REAPER_UNIT=${BOXERY_REAPER_UNIT:-${PROXY_UNIT/proxy/reaper}}
start_reaper() {
	local env="BOXERY_CONF=$CONF BOXERY_BACKEND=$BACKEND"
	if [[ $(uname) == Darwin ]]; then
		local plist=$HOME/Library/LaunchAgents/dev.$REAPER_UNIT.plist
		cat >"$plist" <<-EOF
			<?xml version="1.0" encoding="UTF-8"?>
			<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
			<plist version="1.0"><dict>
			  <key>Label</key><string>dev.$REAPER_UNIT</string>
			  <key>ProgramArguments</key><array><string>$ROOT/host/boxery-host</string><string>reap</string></array>
			  <key>EnvironmentVariables</key><dict><key>BOXERY_CONF</key><string>$CONF</string><key>PATH</key><string>$(dirname "$(command -v node)"):/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string></dict>
			  <key>StartInterval</key><integer>60</integer>
			  <key>StandardOutPath</key><string>$HOME/Library/Logs/$REAPER_UNIT.log</string>
			  <key>StandardErrorPath</key><string>$HOME/Library/Logs/$REAPER_UNIT.log</string>
			</dict></plist>
		EOF
		launchctl bootout "gui/$(id -u)/dev.$REAPER_UNIT" 2>/dev/null || true
		launchctl bootstrap "gui/$(id -u)" "$plist"
	else
		cat >"$HOME/.config/systemd/user/$REAPER_UNIT.service" <<-EOF
			[Unit]
			Description=boxery: reset expired/orphaned leases
			[Service]
			Type=oneshot
			Environment=$env PATH=$(dirname "$(command -v node)"):/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
			ExecStart=$ROOT/host/boxery-host reap
		EOF
		cat >"$HOME/.config/systemd/user/$REAPER_UNIT.timer" <<-EOF
			[Unit]
			Description=boxery: lease reaper every minute
			[Timer]
			OnBootSec=1min
			OnUnitActiveSec=1min
			AccuracySec=10s
			[Install]
			WantedBy=timers.target
		EOF
		systemctl --user daemon-reload
		systemctl --user enable --now "$REAPER_UNIT.timer" >/dev/null
	fi
}

proxy_bind() { if declare -F backend_proxy_bind >/dev/null; then backend_proxy_bind; else echo 127.0.0.1; fi; }

cmd_init() {
	need jq; need node; need nc; need openssl; need ps
	node --disable-warning=ExperimentalWarning -e 'require("node:sqlite")' 2>/dev/null || die "node $(node --version) lacks node:sqlite; need Node >= 22.13"
	backend_check
	ensure_tokens
	touch "$CONF/authorized_keys"; chmod 600 "$CONF/authorized_keys"
	host_pubkey >/dev/null
	[[ -f $CONF/proxy.env ]] || cat >"$CONF/proxy.env" <<-'EOF'
		# Optional upstream API keys for the boxery LLM proxy (stay on the host).
		# ChatGPT/Codex OAuth is read from ~/.pi/agent/auth.json automatically.
		#OPENAI_API_KEY=
		#ANTHROPIC_API_KEY=
	EOF
	chmod 600 "$CONF/proxy.env"
	{
		printf 'BOXERY_BACKEND=%s\nBOXERY_PROXY_PORT=%s\nBOXERY_PROXY_UNIT=%s\n' "$BACKEND" "$PROXY_PORT" "$PROXY_UNIT"
		for k in BOXERY_POOL BOXERY_POOL_DIR BOXERY_BASE_VOL BOXERY_DOMAIN_PREFIX BOXERY_LIMA_PREFIX BOXERY_CH_DIR BOXERY_CH_NET BOXERY_CH_DNS BOXERY_CH_FIRMWARE BOXERY_EXE_DIR BOXERY_EXE_PREFIX BOXERY_EXE_KEY BOXERY_EXE_PORT_BASE BOXERY_EXE_GUEST_PORT BOXERY_EXE_EGRESS BOXERY_EXE_POOL BOXERY_EXE_MAX_CPUS BOXERY_EXE_MAX_MEM; do [ -z "${!k:-}" ] || printf '%s=%s\n' "$k" "${!k}"; done
		[ -z "${BOXERY_CH_SUDO+x}" ] || printf 'BOXERY_CH_SUDO=%s\n' "$BOXERY_CH_SUDO"   # "" (run as root) is a real value
	} >"$CONF/host.env"
	backend_init
	mkdir -p "$HOME/.local/bin" "$HOME/.config/systemd/user"
	if [[ -z ${BOXERY_CONF:-} ]]; then
		ln -sf "$ROOT/host/boxery-host" "$HOME/.local/bin/boxery-host"
		ln -sf "$ROOT/controller/boxery" "$HOME/.local/bin/boxery"
	fi
	start_proxy_services
	[[ -n ${BOXERY_NO_SERVICES:-} ]] || start_reaper
	log "init done. Next: boxery-host build-base"
}

cmd_add_key() { # pubkey on stdin
	mkdir -p "$CONF"; touch "$CONF/authorized_keys"
	local k; k=$(cat)
	[[ $k == ssh-* || $k == ecdsa-* ]] || die "expected an ssh public key on stdin"
	grep -qxF "$k" "$CONF/authorized_keys" || echo "$k" >>"$CONF/authorized_keys"
	log "key registered ($(wc -l <"$CONF/authorized_keys") total)"
}

cmd_build_base() { backend_check; backend_build_base; }

# All conflicting resources are held through the whole operation, not individual backend calls.
with_vm_lock() { # NAME function args...
	local name=$1; shift
	case ${BOXERY_LOCKS:-} in *":$name:"*) ( "$@" ) ;;
	*) operations run "$name" "$0" "$@" ;;
	esac
}

cmd_new() { # NAME [--cpus N --mem MiB --disk GiB] [--from IMAGE]
	local name="" cpus=4 mem=8192 disk=40 from=""
	while (($#)); do
		case $1 in
		--cpus) valid_num "$1" "${2:-}"; cpus=$2; shift 2 ;;
		--mem) valid_num "$1" "${2:-}"; mem=$2; shift 2 ;;
		--disk) valid_num "$1" "${2:-}"; disk=$2; shift 2 ;;
		--from) valid_image "${2:-}"; from=$2; shift 2 ;;
		-*) die "unknown flag $1" ;;
		*) name=$1; shift ;;
		esac
	done
	[[ -n $name ]] || die "usage: new NAME [--cpus N] [--mem MiB] [--disk GiB] [--from IMAGE]"
	valid_name "$name"
	backend_exists "$name" && die "$name already exists"
	backend_has_base || die "no base image; run: boxery-host build-base"
	[[ -z $from ]] || image_exists "$from" || die "no such image: $from (boxery-host images)"
	local action userdata; action=$(intent create "$name")
	userdata=$(boxery_seed "$name")
	backend_new "$name" "$cpus" "$mem" "$disk" "$userdata" "$from"
	local ep host port; ep=$(backend_wait_endpoint "$name"); host=${ep% *}; port=${ep#* }
	log "$name reachable at $host:$port; waiting for ssh + cloud-init"
	wait_ssh "$host" "$port"
	vm_ssh_cmd "$host" "$port" 'cloud-init status --wait >/dev/null 2>&1; true'
	# A VM made from an image starts with another VM's disk. Whatever the backend did to give it its own
	# identity, make sure of the parts boxery's security depends on: exactly this host's keys (never the
	# source's lease holder), and nothing pushed by grants (tmpfs, so normally gone already).
	if [[ -n $from ]]; then
		pet_set_keys "$name" || die "could not reset ssh keys on $name"
		vm_ssh_cmd "$host" "$port" 'rm -rf "/run/user/$(id -u)/boxery"' || true
	fi
	vm_ssh_cmd "$host" "$port" 'for i in $(seq 60); do curl -fsS -o /dev/null 127.0.0.1:6080/vnc.html && exit 0; sleep 1; done; exit 1' ||
		log "warning: noVNC not answering yet"
	intent_done "$action"
	log "$name ready"
	echo "$name $host:$port"
}

cmd_ls() { # [--json]
	local j; j=$(ls_json)
	if [[ ${1:-} == --json ]]; then printf '%s\n' "$j"; return; fi
	[[ -z ${1:-} ]] || die "usage: ls [--json]"
	printf '%-16s %-10s %-16s %-10s %s\n' NAME STATE ADDR DISK LEASE
	jq -r '.[] | [.name, .state // "-", .addr // "-", .disk // "-", .lease.state // "-"] | @tsv' <<<"$j" |
		while IFS=$'\t' read -r n st addr disk l; do printf '%-16s %-10s %-16s %-10s %s\n' "$n" "$st" "$addr" "$disk" "$l"; done
}

cmd_ip() { valid_name "$1"; local ep; ep=$(backend_ssh_endpoint "$1"); echo "${ep% *}"; }

# Used as an ssh ProxyCommand by controllers: `ssh host boxery-host connect NAME [PORT]`.
cmd_connect() {
	local n=${1%.boxery} port=${2:-22}
	valid_name "$n"
	local ep; ep=$(backend_ssh_endpoint "$n")
	[[ $port == 22 ]] || die "connect: only the ssh port is supported (forward other ports over ssh)"
	exec nc "${ep% *}" "${ep#* }"
}

cmd_start() {
	valid_name "$1"; backend_start "$1"
	local ep; ep=$(backend_wait_endpoint "$1"); wait_ssh "${ep% *}" "${ep#* }"
	if ! is_pool "$1"; then pet_set_keys "$1"; fi
	log "$1 started"
}
cmd_stop() { valid_name "$1"; backend_stop "$1"; log "$1 shutting down"; }

cleanup_vm_images() {
	local images image; images=$(backend_images) || return 1
	while IFS= read -r image; do
		[[ -z $image ]] || backend_image_rm "$image" || return 1
	done < <(printf '%s\n' "$images" | cut -f1 | grep "^$1@" || true)
}
_rm() {
	backend_rm "$1"
	# Forks and image readers hold this source's lock until all copies are independent.
	cleanup_vm_images "$1"
}
cmd_rm() {
	valid_name "$1"
	is_pool "$1" && die "$1 is a pool VM; run: boxery-host pool rm $1 (after its lease ends)"
	backend_exists "$1" || die "no such vm: $1"
	local action; action=$(intent remove "$1")
	_rm "$1"
	token_del "$1"
	edge_clear "$1"
	intent_done "$action"
	log "$1 removed with its snapshots (proxy token revoked)"
}

# ---------------------------------------------------------------- images: snapshots and forks
# One primitive on every backend: capture a VM's disk as an immutable image, and boot VMs from images.
#   snap   = capture NAME → NAME@LABEL          revert = put NAME's own image back (reimage)
#   fork   = capture SRC → new VM(s) from it    pool   = reset to NAME@boxery-clean
# Images hold disk state only (no RAM): processes restart, and tmpfs grants are never captured.

cmd_snap() { # NAME [LABEL]
	valid_name "$1"; local s=${2:-snap-$(date +%Y%m%d-%H%M%S)}; valid_snap "$s"
	backend_exists "$1" || die "no such vm: $1"
	image_exists "$1@$s" && die "snapshot $1@$s exists (boxery-host snap-rm $1 $s)"
	capture_vm "$1" "$1@$s"
	log "snapshot $1@$s"
}
snaps_lines() { # NAME → LABEL<TAB>CREATED<TAB>SIZE (pool clean state and in-flight fork images included)
	backend_exists "$1" || die "no such vm: $1"
	backend_images | awk -F'\t' -v p="$1@" 'index($1, p) == 1 { print substr($1, length(p) + 1) "\t" $2 "\t" $3 }'
	if declare -F backend_legacy_snaps >/dev/null; then backend_legacy_snaps "$1" | awk '{ print $0 "\t(legacy)\t-" }'; fi
}
cmd_snaps() { # NAME [--json]
	valid_name "${1:-}"
	case ${2:-} in --json) snaps_json "$1" ;; '') snaps_lines "$1" ;; *) die "usage: snaps NAME [--json]" ;; esac
}
cmd_snap_rm() { # NAME LABEL
	valid_name "$1"; valid_snap "${2:-}"
	[[ $2 != "$POOL_SNAP" ]] || ! is_pool "$1" || die "$1@$2 is the pool's clean state"
	snaps_lines "$1" | cut -f1 | grep -xF "$2" >/dev/null || die "no snapshot $1@$2"
	local action; action=$(intent snapshot-remove "$1" "$2")
	_delete_snapshot "$1" "$2"
	intent_done "$action"
	log "removed snapshot $1@$2"
}
_delete_snapshot() { # idempotent replay of a previously validated removal
	local images legacy; images=$(backend_images) || die "cannot inspect images during removal"
	if printf '%s\n' "$images" | cut -f1 | grep -xF "$1@$2" >/dev/null; then
		backend_image_rm "$1@$2"
	elif declare -F backend_legacy_snaps >/dev/null; then
		legacy=$(backend_legacy_snaps "$1") || die "cannot inspect legacy snapshots"
		if grep -xF "$2" <<<"$legacy" >/dev/null; then backend_legacy_snap_rm "$1" "$2"; fi
	fi
}
cmd_images() { printf '%-40s %-20s %s\n' IMAGE CREATED SIZE; backend_images | while IFS=$'\t' read -r i c z; do printf '%-40s %-20s %s\n' "$i" "$c" "$z"; done; }

_revert() { # NAME LABEL
	restore_vm "$1" "$2"
	local ep h p; ep=$(backend_wait_endpoint "$1"); h=${ep% *}; p=${ep#* }
	wait_ssh "$h" "$p"
	# Guest clock may resume from snapshot time (legacy memory snapshots); step it to host time.
	vm_ssh_cmd "$h" "$p" "sudo date -u -s @$(date -u +%s) >/dev/null" || true
}
cmd_revert() {
	valid_name "$1"; [[ -n ${2:-} ]] || die "usage: revert NAME SNAP"; valid_snap "$2"
	backend_exists "$1" || die "no such vm: $1"
	is_pool "$1" && die "$1 is a pool VM; it is reset on release"
	snaps_lines "$1" | cut -f1 | grep -xF "$2" >/dev/null || die "no snapshot $2 for $1"
	local action; action=$(intent revert "$1" "$2")
	_revert "$1" "$2"
	intent_done "$action"
	log "$1 reverted to $2"
}

# ---------------------------------------------------------------- edge grants
# Per-VM HTTP credential routes for the proxy's /edge/ path (values never enter the VM).
# stdin: {"HOST": {"headers": {"Name": "value"}, "readonly": bool}, …}   ({} clears)
EDGE_DIR=$CONF/edge
edge_clear() { rm -f "$EDGE_DIR/$1.json"; }
cmd_edge_set() {
	valid_name "${1:-}"
	backend_exists "$1" || die "no such VM: $1"
	local in tmp
	in=$(head -c 262144) || die "could not read routes"
	# Same host/header rules as the proxy; reject anything that could smuggle a header or hit an IP/port.
	jq -e '
		type == "object" and (to_entries | all(
			(.key | test("^(?=.{1,253}$)[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*\\.[a-z]{2,63}$")) and
			(.value | type == "object") and
			((.value.readonly // false) | type == "boolean") and
			((.value.headers // {}) | type == "object" and (to_entries | all(
				(.key | test("^[A-Za-z0-9-]{1,64}$")) and
				(.key | ascii_downcase | IN("host", "content-length", "connection", "transfer-encoding", "te", "upgrade", "proxy-connection", "keep-alive", "trailer") | not) and
				(.value | type == "string" and (test("[\r\n\u0000]") | not) and length <= 8192)
			)))
		))' <<<"$in" >/dev/null 2>&1 || die "edge-set: invalid routes (hosts must be DNS names; header names [A-Za-z0-9-]; no CR/LF)"
	mkdir -p "$EDGE_DIR"; chmod 700 "$EDGE_DIR"
	if [[ $(jq length <<<"$in") == 0 ]]; then edge_clear "$1"; log "$1: edge routes cleared"; return; fi
	tmp=$(mktemp "$EDGE_DIR/.$1.XXXX"); chmod 600 "$tmp"
	jq -c '{hosts: .}' <<<"$in" >"$tmp" && mv "$tmp" "$EDGE_DIR/$1.json"
	log "$1: edge routes → $(jq -r 'keys | join(", ")' <<<"$in")"
}

# fork SRC DST... [--cpus N --mem MiB --disk GiB]: capture SRC once (it keeps running), then boot every
# DST from that image with its own identity (hostname, proxy token, ssh keys, network). Prints
# "DST ADDR" per fork, like new. The capture is temporary: forks never depend on it.
cmd_fork() {
	local src="" dsts=() flags=() d
	while (($#)); do
		case $1 in
		--cpus | --mem | --disk) valid_num "$1" "${2:-}"; flags+=("$1" "$2"); shift 2 ;;
		-*) die "unknown flag $1" ;;
		*) if [[ -z $src ]]; then src=$1; else dsts+=("$1"); fi; shift ;;
		esac
	done
	[[ -n $src && ${#dsts[@]} -gt 0 ]] || die "usage: fork SRC DST... [--cpus N --mem MiB --disk GiB]"
	valid_name "$src"; backend_exists "$src" || die "no such vm: $src"
	for d in "${dsts[@]}"; do
		valid_name "$d"; backend_exists "$d" && die "$d already exists"
		[[ $(printf '%s\n' "${dsts[@]}" | grep -cxF "$d") == 1 ]] || die "duplicate fork name $d"
	done
	local img; img="$src@fork-$(date +%Y%m%d%H%M%S)-$(openssl rand -hex 3)"
	local cleanup; cleanup=$(intent fork-image "$img")
	local t0=$SECONDS
	capture_vm "$src" "$img"
	log "captured $src in $((SECONDS - t0))s; booting ${#dsts[*]} fork(s)"
	# Boot the forks in parallel; print results in argument order.
	local out=$CONF/work/$BOXERY_OPERATION_ID/fork-output rc=0; mkdir -p "$out"
	for d in "${dsts[@]}"; do ( cmd_new "$d" ${flags[@]+"${flags[@]}"} --from "$img" >"$out/$d" ) & done
	wait
	for d in "${dsts[@]}"; do if [[ -s $out/$d ]]; then cat "$out/$d"; else rc=1; log "fork $d failed"; fi; done
	rm -rf "$out"
	backend_image_rm "$img"
	intent_done "$cleanup"
	log "forked $src → ${dsts[*]} in $((SECONDS - t0))s"
	return $rc
}

cmd_proxy_log() {
	if [[ $(uname) == Darwin ]]; then tail -n "${1:-30}" "$HOME/Library/Logs/$PROXY_UNIT.log"
	else journalctl --user -u "$PROXY_UNIT" -n "${1:-30}" --no-pager -o cat; fi
}

usage() {
	cat <<-EOF
		boxery-host — Ubuntu desktop VMs for coding agents (backend: $BACKEND)

		  init [--backend libvirt|lima|cloud-hypervisor|exe]  install proxy services + backend setup, symlinks
		  build-base                build the golden desktop image (one-time)
		  add-key < key.pub         authorize a controller's ssh key for new VMs
		  new NAME [--cpus N --mem MiB --disk GiB]
		  new NAME --from IMAGE     boot a new VM from an image (e.g. demo@s1)
		  fork SRC DST... [--cpus N --mem MiB --disk GiB]
		                            copy a VM (running or not) into new VMs with their own identity
		  ls [--json] | ip NAME | start NAME | stop NAME | rm NAME
		  snap NAME [SNAP] | snaps NAME [--json] | snap-rm NAME SNAP | revert NAME SNAP | images
		  connect NAME [PORT]       stdio to VM port (for ssh ProxyCommand)
		  proxy-log [N]             recent LLM + edge proxy requests
		  edge-set NAME < routes.json   set the VM's edge credential routes (used by boxery grant http:…)

		  pool add NAME | rm NAME [--force] | ls [--json]   shared pool of leasable VMs
		  acquire --holder H [--ttl S] [--wait S]    lease a FREE pool VM (lease ssh pubkey on stdin)
		  renew LEASE [--ttl S] | release LEASE | reap | reconcile
	EOF
}

load_backend
c=${1:-help}; shift || true
case $c in
__dispatch) c=$1; shift ;;
__call) "$@"; exit ;;
__recover) recover_operation; exit ;;
new|fork|start|stop|rm|delete|snap|snap-rm|revert|edge-set)
	BOXERY_BACKEND=$BACKEND exec node --disable-warning=ExperimentalWarning "$ROOT/host/boxery-operations.mjs" dispatch "$CONF" "$0" "$c" "$@" ;;
pool)
	if [[ ${1:-} == add || ${1:-} == rm ]]; then
		BOXERY_BACKEND=$BACKEND exec node --disable-warning=ExperimentalWarning "$ROOT/host/boxery-operations.mjs" dispatch "$CONF" "$0" "$c" "$@"
	fi ;;
esac
case $c in
init)
	if [[ ${1:-} == --backend ]]; then BACKEND=$2; load_backend; fi
	cmd_init ;;
backend) echo "$BACKEND" ;;
build-base) cmd_build_base ;;
add-key) cmd_add_key ;;
new) cmd_new "$@" ;;
ls | list) cmd_ls "$@" ;;
ip) cmd_ip "$@" ;;
connect) cmd_connect "$@" ;;
start) cmd_start "$@" ;;
stop) cmd_stop "$@" ;;
rm | delete) cmd_rm "$@" ;;
snap) cmd_snap "$@" ;;
snaps) cmd_snaps "$@" ;;
snap-rm) cmd_snap_rm "$@" ;;
images) cmd_images ;;
fork) cmd_fork "$@" ;;
revert) cmd_revert "$@" ;;
proxy-log) cmd_proxy_log "$@" ;;
edge-set) cmd_edge_set "$@" ;;
