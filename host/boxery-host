#!/usr/bin/env bash
# boxery-host: manage Ubuntu desktop VMs for coding agents.
# Runs on the VM host (Linux with libvirt, macOS/Linux with Lima, or anywhere with ssh for exe.dev). The
# controller (`boxery`) calls it over ssh, or directly when the controller runs on the host itself (HOST=local).
# Entry point only: commands run in Node (host/boxery-host.mjs). `connect` is the ssh ProxyCommand for
# every VM connection, so it stays in Bash (host/backend.sh) and never pays Node's startup.
# VM-platform specifics live in host/backends/<backend>.sh (see host/backends/README.md).
set -eu

resolve() { local p=$1; while [ -L "$p" ]; do local t; t=$(readlink "$p"); case $t in /*) p=$t ;; *) p=$(dirname "$p")/$t ;; esac; done; echo "$p"; }  # macOS has no readlink -f
ROOT=$(cd "$(dirname "$(resolve "$0")")/.." && pwd)

if [ "${1:-}" = connect ]; then shift; exec "$ROOT/host/backend.sh" __connect "$@"; fi

# The node `init` recorded: nvm/fnm shims are often missing from PATH in non-interactive ssh sessions.
node=${BOXERY_NODE:-}
conf=${BOXERY_CONF:-$HOME/.config/boxery}
if [ -z "$node" ] && [ -f "$conf/host.env" ]; then node=$(sed -n 's/^BOXERY_NODE=//p' "$conf/host.env" | tail -n 1); fi
if [ -z "$node" ] || [ ! -x "$node" ]; then
	node=$(command -v node) || { echo "boxery-host: node not found (need Node >= 22.13; run boxery-host init with it on PATH)" >&2; exit 1; }
fi
exec "$node" --disable-warning=ExperimentalWarning "$ROOT/host/boxery-host.mjs" "$@"
